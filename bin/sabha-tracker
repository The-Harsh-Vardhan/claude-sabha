#!/usr/bin/env python3
"""sabha-tracker: atomic row edits on a tracker CSV (header row = column names).

  sabha-tracker <file.csv> get <keycol> <key>
  sabha-tracker <file.csv> add col=val [col=val ...]
  sabha-tracker <file.csv> set <keycol> <key> col=val [col=val ...]     (row must exist; first match)
  sabha-tracker <file.csv> upsert <keycol> <key> col=val [col=val ...]  (set, or add with keycol=key)
  sabha-tracker <file.csv> delete <keycol> <key>
  sabha-tracker --self-test

Every write holds an exclusive lock on <file>.lock, writes a temp file in the same directory, fsyncs it and renames it
over the original, so a reader sees the old file or the new one, never half a row. Unknown columns are refused.
Exit 0 ok, 1 failed (row missing, bad column), 2 usage.
"""
import csv, os, sys, tempfile

try:
    import fcntl
except ImportError:  # ponytail: no flock on Windows Python; O_EXCL lock file below, a crashed holder leaves it (UNTESTED)
    fcntl = None


class Lock:
    def __init__(self, path):
        self.path = path + ".lock"

    def __enter__(self):
        if fcntl:
            self.f = open(self.path, "a")
            fcntl.flock(self.f, fcntl.LOCK_EX)
        else:
            import time
            for _ in range(200):
                try:
                    self.fd = os.open(self.path, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
                    break
                except FileExistsError:
                    time.sleep(0.05)
            else:
                raise SystemExit("sabha-tracker: lock busy: " + self.path)
        return self

    def __exit__(self, *a):
        if fcntl:
            fcntl.flock(self.f, fcntl.LOCK_UN)
            self.f.close()
        else:
            os.close(self.fd)
            os.unlink(self.path)


def load(path):
    with open(path, newline="") as f:
        rows = list(csv.reader(f))
    if not rows:
        raise SystemExit("sabha-tracker: empty file (needs a header row): " + path)
    return rows[0], rows[1:]


def save(path, head, rows):
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(os.path.abspath(path)), prefix=".tracker-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", newline="") as f:
            w = csv.writer(f, lineterminator="\n")
            w.writerow(head)
            w.writerows(rows)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, os.stat(path).st_mode & 0o7777)
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def pairs(head, args):
    out = {}
    for a in args:
        k, sep, v = a.partition("=")
        if not sep or k not in head:
            raise SystemExit("sabha-tracker: bad column in '%s' (columns: %s)" % (a, ",".join(head)))
        out[k] = v
    return out


def col(head, name):
    if name not in head:
        raise SystemExit("sabha-tracker: no column '%s' (columns: %s)" % (name, ",".join(head)))
    return head.index(name)


def find(head, rows, kc, key):
    i = col(head, kc)
    for n, r in enumerate(rows):
        if i < len(r) and r[i] == key:
            return n
    return -1


def run(argv):
    try:
        return _run(argv)
    except SystemExit as e:
        if isinstance(e.code, str):
            print(e.code, file=sys.stderr)
            return 1
        raise


def _run(argv):
    if len(argv) < 2:
        print(__doc__, file=sys.stderr)
        return 2
    path, cmd, args = argv[0], argv[1], argv[2:]
    need = {"get": 2, "add": 1, "set": 3, "upsert": 3, "delete": 2}
    if cmd not in need or len(args) < need[cmd]:
        print(__doc__, file=sys.stderr)
        return 2
    if not os.path.isfile(path):
        print("sabha-tracker: no such file " + path, file=sys.stderr)
        return 1
    with Lock(path):
        head, rows = load(path)
        if cmd == "get":
            n = find(head, rows, args[0], args[1])
            if n < 0:
                print("sabha-tracker: no row with %s=%s" % (args[0], args[1]), file=sys.stderr)
                return 1
            csv.writer(sys.stdout, lineterminator="\n").writerow(rows[n])
            return 0
        if cmd == "add":
            vals = pairs(head, args)
            rows.append([vals.get(h, "") for h in head])
        elif cmd == "delete":
            n = find(head, rows, args[0], args[1])
            if n < 0:
                print("sabha-tracker: no row with %s=%s" % (args[0], args[1]), file=sys.stderr)
                return 1
            del rows[n]
        else:
            vals = pairs(head, args[2:])
            n = find(head, rows, args[0], args[1])
            if n < 0 and cmd == "set":
                print("sabha-tracker: no row with %s=%s" % (args[0], args[1]), file=sys.stderr)
                return 1
            if n < 0:
                vals.setdefault(args[0], args[1])
                rows.append([vals.get(h, "") for h in head])
            else:
                r = rows[n] + [""] * (len(head) - len(rows[n]))
                for k, v in vals.items():
                    r[head.index(k)] = v
                rows[n] = r
        save(path, head, rows)
    return 0


def self_test():
    d = tempfile.mkdtemp()
    p = os.path.join(d, "t.csv")
    with open(p, "w") as f:
        f.write("id,title,state\n1,first,OPEN\n")
    sh = lambda *a: run([p] + list(a))
    assert sh("add", "id=2", 'title=has, comma "and quote"', "state=OPEN") == 0
    assert sh("set", "id", "1", "state=DONE") == 0
    assert sh("set", "id", "9", "state=DONE") == 1
    assert sh("upsert", "id", "3", "title=new") == 0
    assert sh("upsert", "id", "3", "state=OPEN") == 0
    assert sh("add", "nope=1") == 1
    assert sh("delete", "id", "2") == 0
    head, rows = load(p)
    assert rows == [["1", "first", "DONE"], ["3", "new", "OPEN"]], rows
    assert not [x for x in os.listdir(d) if x.endswith(".tmp")], os.listdir(d)
    # a failing write must leave the original untouched and no temp file behind
    before = open(p).read()
    orig = os.replace
    os.replace = lambda a, b: (_ for _ in ()).throw(OSError("boom"))
    try:
        sh("add", "id=7")
        raise AssertionError("expected OSError")
    except OSError:
        pass
    finally:
        os.replace = orig
    assert open(p).read() == before and not [x for x in os.listdir(d) if x.endswith(".tmp")]
    # parallel writers do not lose rows
    import subprocess
    ps = [subprocess.Popen([sys.executable, __file__, p, "add", "id=w%d" % i]) for i in range(12)]
    assert all(x.wait() == 0 for x in ps)
    assert len(load(p)[1]) == 14, len(load(p)[1])
    print("ok: add/set/upsert/delete, quoting, bad column and missing row refused, failed write leaves file intact, 12 parallel adds kept")
    return 0


if __name__ == "__main__":
    if sys.argv[1:] == ["--self-test"]:
        sys.exit(self_test())
    sys.exit(run(sys.argv[1:]))
