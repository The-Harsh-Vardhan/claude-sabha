#!/usr/bin/env bash
# Read-only report: each role's context percent, its age and state, the restart line for a tab
# above 30 percent that is not mid-task, the user's open items, and briefs nobody has acked. With SABHA_RUN_AUTO=1 it
# then runs one sabha-run pass, so whatever calls sabha-watch on a schedule also starts headless runs.
# A new inbox/<Role>/NNN.done is announced once with sabha-nudge: to the dispatcher, or to the relay for a .done in the
# dispatcher's own inbox. The first pass only records the dones that already exist. SABHA_NUDGE_BIN replaces sabha-nudge (tests).
#   sabha-watch
# Paths come from sabha.conf and the team's .sabha/config (sabha_conf_read in sabha-lib.sh). Always exits 0.
set -uo pipefail

BIN=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=sabha-lib.sh
. "$BIN/sabha-lib.sh"
sabha_conf_read sabha-watch 2>&1 || exit 0
IMPL=${SABHA_IMPL:?missing from sabha.conf}
# banner: the usage windows statusline-sabha.sh recorded and whether SABHA_STOP holds (bin/sabha-limits.sh)
# shellcheck source=sabha-limits.sh
. "$BIN/sabha-limits.sh"
sabha_limits_banner
LIMIT=30 STALE_MIN=15 UNACKED_MIN=10
# RELAY and DISPATCHER (themed names) come from sabha_load; it exits on a bad config, so probe it in a subshell first
RELAY="" DISPATCHER=""
if (sabha_load sabha-watch) >/dev/null 2>&1; then sabha_load sabha-watch; fi
now=$(date +%s)
age_min() { echo $(( (now - $(date -r "$1" +%s)) / 60 )); }

# mid-task = a brief with an .ack and neither .done nor .cancel
mid_task() {
  local a n
  for a in "$IMPL/inbox/$1"/[0-9][0-9][0-9]*.ack; do
    [[ -e $a ]] || continue
    n=${a%.ack}
    [[ -e $n.done || -e $n.cancel ]] || { echo "inbox/$1/$(basename "$n") acked $(date -r "$a" +%H:%M), no done"; return 0; }
  done
  return 1
}

for entry in ${SABHA_ROSTER:-}; do
  name=${entry%%:*}
  lower=$(tr '[:upper:]' '[:lower:]' <<<"$name")
  ctx=$IMPL/status/context/$lower.txt
  if [[ ! -f $ctx ]]; then printf '%-13s  %5s  %4s  %s\n' "$name" - - "no context file"; continue; fi
  pct=$(tr -d ' \n' <"$ctx"); age=$(age_min "$ctx")
  if task=$(mid_task "$name"); then state="mid-task  ($task)"
  elif (( age > STALE_MIN )); then state=stale
  else state=idle; fi
  line=$(printf '%-13s  %4s%%  %3sm  %s' "$name" "$pct" "$age" "$state")
  # a percent can be fractional (12.5), so compare in awk
  if [[ $state != mid-task* ]] && awk -v p="$pct" -v l="$LIMIT" 'BEGIN { exit !(p + 0 > l) }'; then
    line+="  RESTART: $("$BIN/sabha-up.sh" --print "$name" 2>&1 | sed -n 1p)"
  fi
  echo "$line"
done

# for-me.items: blocks split by '---'; a later block with the same id overrides state. Like the board, an item with
# no state is open, and a last block without a trailing newline is torn (still being written) and is skipped.
if [[ -f $IMPL/for-me.items ]]; then
  torn=0; [[ -s $IMPL/for-me.items && $(tail -c1 "$IMPL/for-me.items" | od -An -c | tr -d ' ') != '\n' ]] && torn=1
  open=$(awk -v torn="$torn" '
    function commit() { if (id != "") { if (!(id in seen)) { seen[id] = 1; order[++n] = id }
                        if (st != "") state[id] = st; if (ti != "" && !(id in title)) title[id] = ti } id = st = ti = "" }
    $0 == "---" { commit(); next }
    /^id: /    { if (id != "") commit(); id = $2; next }
    /^state: / { st = $2; next }
    /^title: / { ti = substr($0, 8); next }
    END { if (!torn) commit()
          for (i = 1; i <= n; i++) if (state[order[i]] != "DONE" && state[order[i]] != "DROPPED")
            printf "%s %s; ", order[i], substr(title[order[i]], 1, 50) }
  ' "$IMPL/for-me.items")
  echo "open for-me items: ${open:-none}"
fi

unacked=""
for b in "$IMPL"/inbox/*/[0-9][0-9][0-9]*-*.md; do
  [[ -e $b ]] || continue
  n=$(basename "$b"); n=${n%%-*}; d=$(dirname "$b")
  [[ -e $d/$n.ack || -e $d/$n.cancel ]] && continue
  (( $(age_min "$b") > UNACKED_MIN )) && unacked+="inbox/$(basename "$d")/$n (sent $(date -r "$b" +%H:%M)) "
done
echo "unacked briefs: ${unacked:-none}"
# wake the receiver of each .done once: status/done-seen/<Role>-<NNN> is claimed with noclobber, so two watchers
# nudge only once; the nudge runs in the background (it waits for the agent to settle) and logs to status/done-nudge.log
SEEN=$IMPL/status/done-seen
# no DISPATCHER (sabha_load failed) means no claim at all: a claimed .done is never announced later
first=0; [[ -d $SEEN ]] || first=1
if [[ -n $DISPATCHER ]] && mkdir -p "$SEEN" 2>/dev/null; then
  nudge=${SABHA_NUDGE_BIN:-$BIN/sabha-nudge}
  for d in "$IMPL"/inbox/*/[0-9][0-9][0-9]*.done; do
    [[ -e $d ]] || continue
    role=$(basename "$(dirname "$d")"); n=$(basename "$d" .done)
    (set -C; : >"$SEEN/$role-$n") 2>/dev/null || continue
    (( first )) && continue
    to=$DISPATCHER; [[ $role == "$DISPATCHER" ]] && to=$RELAY
    ( "$nudge" "$to" "see inbox/$role/$n.done" </dev/null >>"$IMPL/status/done-nudge.log" 2>&1 || echo "nudge $to failed for inbox/$role/$n.done" >>"$IMPL/status/done-nudge.log" ) &
  done
fi
# the headless runner rides on this report instead of a loop of its own (docs/headless-runner.md)
[[ ${SABHA_RUN_AUTO:-0} == 1 ]] && "$BIN/sabha-run"
exit 0
