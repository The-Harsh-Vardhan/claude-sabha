#!/usr/bin/env bash
# Stale pane reaper. Lists every named claude session (oldest first) with its age, idle time, last context % (the cost
# proxy) and herdr pane state, marks resumed duplicates (STALE? = an older copy of a role that has a newer one), and
# lists ORPHAN panes (a pane the pane map names for a claude role that ps sees no named claude for). It closes nothing
# by itself.
#   sabha-reap                    list (read-only)
#   sabha-reap --close <id>...    close what you name: a pid (TERM to that claude) or an ORPHAN pane id (herdr pane
#                                 close). A role's last live copy is refused; so is any id the list does not show.
# A pane is closed only when herdr itself reports it idle or done (agent_status), the pane is not the one this command
# runs in (HERDR_PANE_ID must be set), and ps shows at least one named claude. When in doubt it refuses.
# Ids: a pid is digits only (leading zeros are stripped before any check); a pane id is like w1:p7.
# Pane ids are compared trimmed and lower-cased; a bare p7 matches every row with that pane part, and a map row without a
# role is MALFORMED: such a pane is listed AMBIGUOUS or MALFORMED and never closed. Role names compare case-insensitively.
# Idle = time since status/context/<name>.txt was last written by the status line (a session that renders no more is
# idle). Exit 0 listed or closed, 1 something named was refused or failed, 2 bad usage or an unreadable process list.
# Tests only: SABHA_PS_FILE replaces the process list (see sabha-lib.sh); --close with it needs SABHA_KILL (a stub for
# kill, honoured only with SABHA_PS_FILE) and, for a pane, SABHA_TEST=1; SABHA_ANCESTORS replaces the ancestor pids;
# SABHA_NOW fixes the clock; SABHA_KILL_GRACE is the TERM wait (default 3 s).
set -uo pipefail

# shellcheck source=sabha-lib.sh
. "$(cd "$(dirname "$0")" && pwd)/sabha-lib.sh"
# shellcheck source=sabha-herdr.sh
. "$(cd "$(dirname "$0")" && pwd)/sabha-herdr.sh"

# every printed line goes through here: printable ASCII only, so ps, file or herdr data cannot carry escape sequences
emit() { printf '%s\n' "$*" | LC_ALL=C tr -cd ' -~\n'; }
usage() { echo "usage: sabha-reap [--close <pid-or-pane-id>...]" >&2; exit 2; }

ids=""
case ${1:-} in
  "") ;;
  --close)
    shift
    (( $# )) || usage
    for a in "$@"; do
      if [[ $a =~ ^[0-9]+$ ]]; then
        c=${a#"${a%%[!0]*}"}
        [[ -n $c && ${#c} -le 9 ]] || usage
      elif [[ $a =~ ^[A-Za-z][A-Za-z0-9_-]*:[A-Za-z0-9_-]+$ ]]; then c=$a
      else usage; fi
      [[ " $ids" == *" $c "* ]] || ids+="$c "
    done ;;
  *) usage ;;
esac

sabha_load sabha-reap
KILL="kill"
if [[ -n ${SABHA_PS_FILE:-} ]]; then KILL=${SABHA_KILL:-kill}
elif [[ -n ${SABHA_KILL:-} ]]; then echo "sabha-reap: SABHA_KILL is a test hook and needs SABHA_PS_FILE" >&2; exit 2; fi
[[ -n $ids && -n ${SABHA_PS_FILE:-} && -z ${SABHA_KILL:-} ]] && { echo "sabha-reap: --close with SABHA_PS_FILE needs SABHA_KILL (a fake list is never signalled)" >&2; exit 2; }

procs=$(sabha_procs) || { echo "sabha-reap: cannot read the process list" >&2; exit 2; }
now=${SABHA_NOW:-$(date +%s)}
epoch() { date -j -f '%Y-%b-%d %H:%M:%S' "$1" +%s 2>/dev/null || date -d "$1" +%s 2>/dev/null || echo 0; }
mtime() { stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null || echo 0; }
span() {
  local s=$1
  (( s < 0 )) && s=0
  if (( s >= 86400 )); then echo "$((s / 86400))d$((s % 86400 / 3600))h"
  elif (( s >= 3600 )); then echo "$((s / 3600))h$((s % 3600 / 60))m"
  else echo "$((s / 60))m"; fi
}

# herdr view: the pane map and the live panes. Any failure leaves panes_ok=0 and says so; it never proves a pane gone.
mapf=$SABHA_IMPL/status/herdr-panes.txt
panes_ok=0 panes_json="" panes_note=""
if [[ $(sabha_backend) != herdr ]]; then panes_note="pane view needs the herdr backend"
elif [[ ! -s $mapf ]]; then panes_note="no status/herdr-panes.txt: no panes recorded"
elif ! command -v herdr >/dev/null 2>&1; then panes_note="herdr not found: could not read panes"
elif ! sabha_herdr_guard; then panes_note="herdr refused: could not read panes"
elif panes_json=$(sabha_h pane list 2>/dev/null </dev/null) && [[ $panes_json == *'"pane_id"'* ]]; then panes_ok=1
else panes_note="could not read herdr panes (is the sabha session running?)"; fi
# a pane id is trimmed (spaces, tabs, CR) and lower-cased before any comparison; a bare id (no w1: part) is the same pane
# as every id with that pane part, so a map row spelling it that way makes the pane ambiguous instead of hiding it
pnorm() { printf '%s' "$1" | LC_ALL=C tr -d ' \t\r' | tr '[:upper:]' '[:lower:]'; }
PANE_AWK='function k(s) { gsub(/[ \t\r]/, "", s); return tolower(s) }
  function pp(s) { sub(/^.*:/, "", s); return s }
  function same(a, b) { a = k(a); b = k(b); return a != "" && b != "" && (a == b || ((a !~ /:/ || b !~ /:/) && pp(a) == pp(b))) }'
pane_of() { awk -v n="$1" "$PANE_AWK"' tolower($1) == tolower(n) { p = $2 } END { print k(p) }' "$mapf" 2>/dev/null; }
# AMBIGUOUS = the map names this pane in two rows, or names one of its roles twice: whose pane it is cannot be told.
# A row with no role (one field) that names it is MALFORMED and counts the same. Prints the rows.
pane_amb() {
  awk -v p="$1" "$PANE_AWK"'
    NF == 0 || k($0) == "" { next }
    { N++; q[N] = $2; r[N] = $1 " " $2; n[N] = k($1) }
    NF == 1 { q[N] = $1; r[N] = "(no role) " $1; n[N] = ""; m[N] = 1 }
    NF > 1 && n[N] == "" { r[N] = "(no role) " $2; m[N] = 1 }
    END { for (i = 1; i <= N; i++) if (n[i] != "") c[n[i]]++
          for (i = 1; i <= N; i++) if (same(q[i], p)) { h++; if (m[i]) bad = 1; else { hn[n[i]] = 1; if (c[n[i]] > 1) bad = 1 } }
          if (h > 1) bad = 1
          if (!bad) exit
          for (i = 1; i <= N; i++) if (same(q[i], p) || (n[i] != "" && hn[n[i]])) printf "%s%s", (j++ ? " / " : ""), r[i] }' "$mapf" 2>/dev/null
}
pane_live() { grep -qF "\"pane_id\":\"$1\"" <<<"$panes_json" || grep -qE "\"pane_id\" *: *\"$1\"" <<<"$panes_json"; }
pane_state() {
  local o
  o=$(grep -o '{[^{}]*}' <<<"$panes_json" | grep -E "\"pane_id\" *: *\"$1\"" | head -1)
  [[ -n $o ]] && o=$(sabha_jid "$o" agent_status)
  echo "${o:--}"
}

# rows: "start_epoch pid role tty" for every copy, oldest first
rows=""
while read -r name pid tty day time; do
  [[ -n $name ]] || continue
  rows+="$(epoch "$day $time") $pid $name $tty"$'\n'
done <<<"$procs"
rows=$(sort -n <<<"$rows" | sed '/^$/d')

emit "$(printf '%-7s %-14s %-7s %-7s %-5s %-8s %-9s %s' pid role age idle ctx pane state note)"
while read -r st pid name tty; do
  [[ -n $name ]] || continue
  n=$(awk -v r="$name" 'tolower($3) == tolower(r)' <<<"$rows" | wc -l | tr -d ' ')
  newest=$(awk -v r="$name" 'tolower($3) == tolower(r) { s = $1 } END { print s }' <<<"$rows")
  note="" pane=- state=-
  if (( n > 1 )); then
    if [[ $st == "$newest" ]]; then note="newest of $n"; else note="STALE?"; fi
  else note="only copy"; fi
  idle=- ctx=-
  # a name from ps is a file name here: only plain names, never a path
  if [[ $name =~ ^[A-Za-z0-9_-]+$ ]]; then
    cf=$SABHA_IMPL/status/context/$(tr '[:upper:]' '[:lower:]' <<<"$name").txt
    if [[ -f $cf ]]; then
      idle=$(span $(( now - $(mtime "$cf") )))
      c=$(head -c 16 "$cf" | tr -cd '0-9.')
      [[ -n $c ]] && ctx=$c%
    fi
  fi
  if [[ $st == "$newest" ]] && (( panes_ok )); then
    p=$(pane_of "$name")
    if [[ -n $p ]] && pane_live "$p"; then pane=$p state=$(pane_state "$p"); fi
  fi
  emit "$(printf '%-7s %-14s %-7s %-7s %-5s %-8s %-9s %s' "$pid" "$name" "$(span $(( now - st )))" "$idle" "$ctx" "$pane" "$state" "$note")"
done <<<"$rows"

# ORPHAN = a mapped pane of a claude role with no named claude in ps. That is a hint, not proof: ps cannot see a claude
# started without -n, so only a pane that herdr also reports idle or done is closable (closable), and never when ps
# shows no named claude at all (a ps format change would make every pane look dead).
orphans=" " closable=" "
if (( panes_ok )) && [[ -z $rows ]]; then emit "panes: ps shows no named claude session, so no pane is called an ORPHAN"
elif (( panes_ok )); then
  while read -r name p _; do
    p=$(pnorm "$p")
    if [[ -n $(pnorm "$name") && -z $p ]]; then emit "$(printf '%-7s %-14s %-7s %-7s %-5s %-8s %-9s %s' MALFORMED "$name" - - - - - "map row has no pane or no role: never closed")"; continue; fi
    [[ -n $name && -n $p ]] || continue
    awk -v r="$name" 'tolower($3) == tolower(r) { f = 1 } END { exit !f }' <<<"$rows" && continue
    pane_live "$p" || continue
    st=$(pane_state "$p")
    amb=$(pane_amb "$p")
    if [[ -n $amb ]]; then
      tag=AMBIGUOUS; [[ $amb == *"(no role)"* ]] && tag=MALFORMED
      emit "$(printf '%-7s %-14s %-7s %-7s %-5s %-8s %-9s %s' "$tag" "$name" - - - "$p" "$st" "map rows ($amb): never closed")"; continue
    fi
    if ! sabha_role "$name" 2>/dev/null; then
      emit "$(printf '%-7s %-14s %-7s %-7s %-5s %-8s %-9s %s' OTHER "$name" - - - "$p" "$st" "not in the roster: not provably dead")"; continue
    elif [[ $R_AGENT != claude ]]; then
      emit "$(printf '%-7s %-14s %-7s %-7s %-5s %-8s %-9s %s' OTHER "$name" - - - "$p" "$st" "runs on $R_AGENT, not claude: not provably dead")"; continue
    fi
    orphans+="$p "
    case $st in idle|done) closable+="$p "; note="no named claude in ps, herdr says $st: closable" ;; *) note="no named claude in ps, herdr says $st: list only" ;; esac
    emit "$(printf '%-7s %-14s %-7s %-7s %-5s %-8s %-9s %s' ORPHAN "$name" - - - "$p" "$st" "$note")"
  done <"$mapf"
else emit "panes: $panes_note"; fi
emit "(ps sees only claude -n/--name sessions; nothing was closed. Close with: sabha-reap --close <pid-or-pane-id>...)"
emit "(ctx is the last context % only; idle is the last status-line render, so a session in a long tool call looks idle; pane state is shown for the newest copy only, so a STALE? copy may be the busy one)"

[[ -n $ids ]] || exit 0

# --- close: only the ids named on this command line --------------------------------------------------------------
rc=0 pids=" "
for id in $ids; do [[ $id =~ ^[0-9]+$ ]] && pids+="$id "; done
ancestors=" $$ ${SABHA_ANCESTORS:-} "
if [[ -z ${SABHA_PS_FILE:-} ]]; then
  p=$PPID
  while (( p > 1 )); do ancestors+="$p "; p=$(ps -o ppid= -p "$p" | tr -d ' '); [[ -n $p ]] || break; done
fi
killed=""
for id in $ids; do
  if [[ $id =~ ^[0-9]+$ ]]; then
    name=$(awk -v p="$id" '$2 == p { print $3 }' <<<"$rows")
    if [[ -z $name ]]; then emit "refused $id: not a pid in the list above"; rc=1; continue; fi
    if [[ $ancestors == *" $id "* ]]; then emit "refused $id: it runs this command"; rc=1; continue; fi
    left=$(awk -v r="$name" -v s="$pids" 'tolower($3) == tolower(r) && !index(s, " " $2 " ")' <<<"$rows" | wc -l | tr -d ' ')
    if (( left < 1 )); then emit "refused $id: that would close every live copy of $name"; rc=1; continue; fi
    if $KILL -TERM "$id" 2>/dev/null; then emit "sent TERM to $id ($name)"; killed+="$id "; else emit "could not signal $id"; rc=1; fi
  else
    why="" amb=$(pane_amb "$id")
    if [[ -n ${SABHA_PS_FILE:-} && -z ${SABHA_TEST:-} ]]; then why="a fake process list never closes a pane"
    elif [[ -z ${HERDR_PANE_ID:-} ]]; then why="HERDR_PANE_ID is not set, so this command cannot tell which pane it runs in"
    elif awk -v a="$id" -v b="$HERDR_PANE_ID" "$PANE_AWK"' BEGIN { exit !same(a, b) }'; then why="it is the pane this command runs in"
    elif [[ -z $rows ]]; then why="ps shows no named claude session, so no pane can be called dead"
    elif [[ $amb == *"(no role)"* ]]; then why="MALFORMED: a pane map row names it with no role ($amb)"
    elif [[ -n $amb ]]; then why="AMBIGUOUS: the pane map has more than one row for it ($amb)"
    elif [[ $orphans != *" $id "* ]]; then why="not an ORPHAN pane in the list above"
    elif [[ $closable != *" $id "* ]]; then why="herdr reports it $(pane_state "$id"); only an idle or done pane is closed"
    elif ! panes_json=$(sabha_h pane list 2>/dev/null </dev/null) || ! pane_live "$id"; then why="the pane is gone or herdr cannot list it now"
    else case $(pane_state "$id") in idle|done) ;; *) why="its state changed to $(pane_state "$id"); only an idle or done pane is closed" ;; esac; fi
    if [[ -n $why ]]; then emit "refused $id: $why"; rc=1; continue; fi
    if sabha_h pane close "$id" >/dev/null 2>&1 </dev/null; then emit "closed pane $id"; else emit "could not close pane $id"; rc=1; fi
  fi
done
if [[ -n $killed ]]; then
  sleep "${SABHA_KILL_GRACE:-3}"
  for id in $killed; do $KILL -0 "$id" 2>/dev/null && { emit "$id is still running after TERM: stop it by hand"; rc=1; }; done
fi
exit "$rc"
