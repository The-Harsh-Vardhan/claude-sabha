#!/usr/bin/env bash
# sabha-perm: the relay's side of the permission relay (docs/inbox-protocol.md section 9). Bash 3.2 safe.
#   sabha-perm list                          open requests (no decision, not expired): id, tool, utc, expires
#   sabha-perm show <id>                     the request file, verbatim (paste it to the user as it is)
#   sabha-perm allow|deny <id> "<words>"     the user's answer, words verbatim (required); written once
#   sabha-perm pane <id> ["<words>"]         hand the request back to the pane's own prompt
#   sabha-perm audit                         allow/deny rows the hook logged that the relay never wrote; exit 1 if any
#   sabha-perm snippet                       the Claude Code settings snippet: SABHA_PERMISSION_MODE and the allow list
#                                            (SABHA_PERMISSION_ALLOW; "default" in it stands for the shipped list)
# Requests live in $SABHA_IMPL/permissions. Nothing here edits a settings file. allow, deny and pane run only with
# SABHA_ROLE set to the relay (sabha-up.sh exports it in the relay's pane; by hand: SABHA_ROLE=<relay> sabha-perm ...).
set -u
usage() { sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
die() { echo "sabha-perm: $*" >&2; exit 1; }
# shellcheck source-path=SCRIPTDIR source=sabha-lib.sh
. "$(dirname "$0")/sabha-lib.sh"
sabha_load sabha-perm
dir=$SABHA_IMPL/permissions
now() { date -u +%Y-%m-%dT%H:%M:%SZ; }
one_line() { printf '%s' "$1" | tr '\t\r\n' '   ' | tr -d '\000-\037'; }
answered() { local e; for e in allow deny pane expired; do [[ -e $dir/$1.$e ]] && { echo "$e"; return 0; }; done; return 1; }
# ISO times in one format compare as strings
expired() { local x; x=$(sed -n 's/^expires: //p' "$dir/$1.req" | head -n 1); [[ -n $x && ! $x > $(now) ]]; }
check_id() { [[ $1 =~ ^[A-Za-z0-9_-]+-[0-9]{3,}$ ]] || die "bad id '$1'"; [[ -f $dir/$1.req ]] || die "no request $1"; }

json_str() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; printf '"%s"' "$s"; }
repo=$(cd "$SABHA_BIN/.." && pwd)
# worktrees sit beside the main clone as <clone>--<slug>, also when this copy is itself a worktree
wts=$(dirname "$repo")/$(basename "$repo" | sed 's/--.*//')--*
both() { local p; for p in "$@"; do printf 'Edit(/%s)\nWrite(/%s)\n' "$p" "$p"; done; }
# The shipped allow list: the relay's routine work and read-only commands, nothing that runs new code or writes a
# file a hook sources. No test or build rule (a worker writes the test it runs), no find (-exec, -delete), no git
# log/diff/show (--output writes any path), no mkdir; writes under SABHA_IMPL only in the folders roles hand work
# through (the permissions folder and the config are outside them).
default_allow() {
  local d
  printf '%s\n' "Read(/$SABHA_IMPL/**)" "Read(/$SABHA_WS/**)" "Read(/$repo/**)" "Read(/$wts/**)"
  for d in inbox status questions; do both "$SABHA_IMPL/$d/**"; done
  both "$SABHA_IMPL/for-me.items" "$SABHA_WS/*--*/**" "$wts/**"
  printf '%s\n' "Bash(git status:*)" "Bash(git branch --show-current)" "Bash(git worktree list:*)" \
    "Bash(ls:*)" "Bash(cat:*)" "Bash(grep:*)" "Bash(wc:*)" "Bash(head:*)" "Bash(tail:*)" "Bash(date:*)" \
    "Bash($SABHA_BIN/sabha-perm:*)" "Bash(sabha-perm:*)"
}
# The deny part is always printed, whatever SABHA_PERMISSION_ALLOW says: deny wins over every allow.
default_deny() {
  local c=${SABHA_CONF:-} rc
  # the files sabha_conf_read sources (a write there is code in every hook), the decision files (sabha-perm only),
  # and git metadata (a rewritten .git file or config runs code through git status, core.fsmonitor)
  if [[ -n $c ]]; then
    both "$c"
    if rc=$(cd -P "$(dirname "$c")" 2>/dev/null && pwd -P); then
      rc=$rc/${c##*/}
      [[ $rc == "$c" ]] || both "$rc"
    fi
  fi
  # the copy of sabha these hooks run from (its hooks, its lib, its plan files) is never a write target
  both "$repo/**" "${SABHA_PLAN_DIR:-$repo}/sabha.*.conf" "$SABHA_IMPL/**/*.conf" "$SABHA_IMPL/*.conf" "$dir/**"
  [[ -n ${SABHA_SHARED:-} ]] && both "$SABHA_SHARED/config"
  # "//**/" is any absolute path ("**/" alone is relative to the session's folder)
  both "/**/.sabha/config" "/**/.sabha/local/**" "/**/.git" "/**/.git/**"
  printf '%s\n' "Read(~/.ssh/**)"
  # and the shared deny list (pushes, gh writes, recursive deletes, .env, .npmrc and key files), each Read(**/x) also
  # as Read(//**/x) so it holds outside the session's folder too
  sed -n 's/^ *"\([A-Z][A-Za-z]*(.*)\)",\{0,1\}$/\1/p' "$repo/share/claude-settings.json" |
    sed 's#^Read(\*\*/\(.*\))$#&\
Read(//**/\1)#'

}

case ${1:-} in
  list)
    [[ -d $dir ]] || exit 0
    for f in "$dir"/*.req; do
      [[ -f $f ]] || continue
      id=${f##*/}; id=${id%.req}
      answered "$id" >/dev/null && continue
      expired "$id" && continue
      printf '%s\t%s\t%s\t%s\n' "$id" "$(sed -n 's/^tool: //p' "$f" | head -n 1)" \
        "$(sed -n 's/^utc: //p' "$f" | head -n 1)" "$(sed -n 's/^expires: //p' "$f" | head -n 1)"
    done
    ;;
  show)
    [[ $# -eq 2 ]] || usage
    check_id "$2"
    cat "$dir/$2.req"
    ;;
  allow|deny|pane)
    [[ $# -ge 2 && $# -le 3 ]] || usage
    d=$1 id=$2 words=$(one_line "${3:-}")
    # the relay names itself; a worker, or a session with no role, is refused. Same account, so this stops a mistake,
    # not a role that sets SABHA_ROLE on purpose (SECURITY.md layer 4)
    [[ ${SABHA_ROLE:-} == "$RELAY" ]] ||
      die "only the relay answers a permission request: run it with SABHA_ROLE=$RELAY (now: ${SABHA_ROLE:-unset})"
    check_id "$id"
    [[ $d == pane || -n ${words// /} ]] || die "$d needs the user's words: sabha-perm $d $id \"<their answer>\""
    if a=$(answered "$id"); then die "$id is already answered ($a)"; fi
    expired "$id" && die "$id has expired; the pane shows its own prompt now"
    nonce=$(sed -n 's/^nonce: //p' "$dir/$id.req" | head -n 1)
    [[ -n $nonce ]] || die "$id.req has no nonce"
    [[ -d $dir && ! -L $dir ]] || die "$dir is not a plain folder"
    [[ ! -L $dir/relay.tsv ]] || die "$dir/relay.tsv is a symlink; refusing"
    tmp=$dir/.$id.$d.$$
    # noclobber: a planted file or symlink at the temp name is never followed
    set -C
    if [[ $d == pane ]]; then
      printf 'id: %s\nutc: %s\nby: %s\n' "$id" "$(now)" "$RELAY" >"$tmp" || die "cannot write $tmp"
      [[ -n $words ]] && printf 'words: %s\n' "$words" >>"$tmp"
    else
      printf 'id: %s\nutc: %s\nby: %s\nnonce: %s\nwords: %s\n' "$id" "$(now)" "$RELAY" "$nonce" "$words" >"$tmp" ||
        die "cannot write $tmp"
    fi
    # ln is atomic and refuses an existing name: the hook never reads half a file, and a decision is written once
    set +C
    if ! ln "$tmp" "$dir/$id.$d" 2>/dev/null; then rm -f "$tmp"; die "$id.$d exists already"; fi
    rm -f "$tmp"
    printf '%s\t%s\t%s\t%s\n' "$(now)" "$id" "$d" "$words" >>"$dir/relay.tsv"
    echo "$id.$d"
    ;;
  audit)
    [[ -f $dir/log.tsv ]] || { echo "audit: no decisions logged"; exit 0; }
    touch "$dir/relay.tsv" 2>/dev/null
    orphans=$(awk -F'\t' 'NR == FNR { seen[$2 "\t" $3] = 1; next }
      ($6 == "allow" || $6 == "deny") && !(($3 "\t" $6) in seen) { print }' "$dir/relay.tsv" "$dir/log.tsv")
    if [[ -n $orphans ]]; then
      echo "audit: decisions the hook honoured that the relay never wrote (forged or hand-written):"
      printf '%s\n' "$orphans"
      exit 1
    fi
    echo "audit: ok, every honoured decision has a relay row"
    ;;
  snippet)
    rules=()
    allow=${SABHA_PERMISSION_ALLOW:-default}
    IFS=';' read -r -a entries <<<"$allow"
    for e in "${entries[@]}"; do
      e=$(printf '%s' "$e" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
      [[ -n $e ]] || continue
      if [[ $e == default ]]; then
        while IFS= read -r r; do rules+=("$r"); done < <(default_allow)
      else
        rules+=("$e")
      fi
    done
    [[ ${#rules[@]} -gt 0 ]] || die "SABHA_PERMISSION_ALLOW holds no rule"
    mode=${SABHA_PERMISSION_MODE:-default}
    deny=()
    while IFS= read -r r; do deny+=("$r"); done < <(default_deny)
    printf '{\n  "permissions": {\n    "defaultMode": %s,\n    "allow": [\n' "$(json_str "$mode")"
    i=0
    for r in "${rules[@]}"; do
      i=$((i + 1)); sep=,; [[ $i -eq ${#rules[@]} ]] && sep=
      printf '      %s%s\n' "$(json_str "$r")" "$sep"
    done
    printf '    ],\n    "deny": [\n'
    i=0
    for r in "${deny[@]}"; do
      i=$((i + 1)); sep=,; [[ $i -eq ${#deny[@]} ]] && sep=
      printf '      %s%s\n' "$(json_str "$r")" "$sep"
    done
    printf '    ]\n  }\n}\n'
    ;;
  *) usage ;;
esac
