#!/usr/bin/env python3
"""Render the sabha board (FOR-ME.md + FOR-ME.html) from for-me.items, status/*.md and inbox/.

  sabha-for-me            render once
  sabha-for-me --watch    render every 15 s until interrupted
  sabha-for-me --csv [dir]  also write agents.csv, for-me.csv and inbox.csv (dir, else SABHA_CSV_DIR); a plain
                          render and --watch write them too when SABHA_CSV_DIR is set

Paths come from sabha.conf (SABHA_CONF, else the nearest .sabha/local/sabha.conf upward, else ../sabha.conf beside this script), the
plan file and the team's .sabha/config (SABHA_SHARED).

Status files, first 10 lines (HEAD_LINES): "Current: <task>" is the Task column and makes the role
busy while it is fresh; "Idle: by design (<reason>)" makes it idle and never STALE; "Blocked:
<reason>" is the only way to show blocked. Words in a Next: line never change the state.
The In flight line is the first Next: after Current:, or the first Next: in the file.
SABHA_TASK_FALLBACK ("Name=text;Name=text") is the task for a role with neither Current nor Idle.

GOALS.md (impl/GOALS.md): one heading per goal, every tag optional and in any order:
  ## <goal title> [P0|P1|P2] (owner: BuilderPrecise; helpers: BuilderHeavy, Reviewer) {state: active|paused|done}
Missing priority = P2, missing owner = "unassigned", missing state = active (done when every box is ticked).
Steps stay "- [x] ..." / "- [ ] ..."; a step may end with "@Name" to name its agent. The board shows one
column per priority (P0 Now, P1 Next, P2 Later), paused and done goals folded, and a Goal column in Agents.

Items: blocks are separated by lines that are exactly "---". A block still open at the end of the
file is torn and waits for the next pass.

Question items (optional extra keys on an item; a plain item has none of them and renders as before):
  ask:     who must answer (the owner in SABHA_USER, or a named person); shown on the card
  q:       the question; an item with q: and at least one option is a question item
  explain: why it matters, one line
  opta: .. opth:  one line per option, "option text | consequence | example" (consequence and example optional)
  rec:     the recommended option letter, e.g. rec: b
The HTML card shows radios, "(Recommended)", the example, a free-text box and a "Copy answer" button that
copies "Answer <id>: B - <option text>", "Answer <id>: <typed text>" or "Answer <id>: B - <text>, note: <typed>"
for pasting to Claude. The page does not reload while a field has focus, a radio is picked or text is typed.
Example block: sabha.conf.example, bottom.
"""
import csv
import datetime as dt
import html
import json
import os
import pathlib
import re
import subprocess
import sys
import tempfile
import time

STALE_MIN = 30
BUSY_MIN = 10
HEAD_LINES = 10
ROOT = os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))


def load_tips(root=ROOT):
    """tips/tips.txt as dicts; a missing file means no tips, and a tip whose needs string is not in bin/ or hooks/
    (a feature on another branch) is left out."""
    try:
        lines = open(os.path.join(root, "tips", "tips.txt"), encoding="ascii", errors="replace").read().splitlines()
    except OSError:
        return []
    code = ""
    for d in ("bin", "hooks"):
        for dp, _, fs in os.walk(os.path.join(root, d)):
            for f in fs:
                try:
                    code += open(os.path.join(dp, f), encoding="utf-8", errors="replace").read()
                except OSError:
                    pass
    out = []
    for l in lines:
        f = l.split("|")
        if not l.strip() or l.startswith("#") or len(f) < 3:
            continue
        f += [""] * (5 - len(f))
        if f[4] and f[4] not in code:
            continue
        out.append(dict(key=f[0], surfaces=f[1].split(","), text=f[2], doc=f[3]))
    return out


def tips_cli(argv):
    tips = load_tips()
    cli = [t for t in tips if "cli" in t["surfaces"]]
    if argv[0] == "--tips":
        for t in cli:
            print("%-17s %s" % (t["key"], t["text"]))
    elif argv[0] == "--tip-help":
        t = next((t for t in cli if t["key"] == (argv[1] if len(argv) > 1 else "")), None)
        if not t:
            print("sabha help: unknown tip. Keys: %s" % " ".join(x["key"] for x in cli), file=sys.stderr)
            sys.exit(1)
        print(t["text"])
        if t["doc"]:
            print("Read more: %s" % t["doc"])
    elif cli:
        # day of year modulo the tips: rotates without state; SABHA_TIP_DAY pins it for tests
        t = cli[int(os.environ.get("SABHA_TIP_DAY") or time.localtime().tm_yday) % len(cli)]
        print("Tip: %s - %s" % (t["key"], t["text"]))


_TIPS = {}


def tip(el, focus=True):
    """Attributes for a board element that has a tip: title is the one channel (hover, focus text, and the accessible description)."""
    t = _TIPS.get(el)
    if not t:
        return ""
    return " data-tip=%s title=\"%s\"%s" % (el, html.escape(t, quote=True), " tabindex=0" if focus else "")


def find_local():
    """The nearest .sabha/local/sabha.conf from the cwd upward (the project the cwd is in), else None. Only the exact cwd
    used to count, so a role in a subdirectory fell through to a sabha.conf beside the scripts."""
    d = os.getcwd()
    while True:
        p = os.path.join(d, ".sabha", "local", "sabha.conf")
        if os.path.exists(p):
            return p
        parent = os.path.dirname(d)
        if parent == d:
            return None
        d = parent


def load_conf():
    here = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..")
    path = os.environ.get("SABHA_CONF") or find_local() or os.path.join(here, "sabha.conf")
    if not os.path.exists(path):
        sys.exit("sabha-for-me: no config at %s (run bin/sabha init)" % path)
    conf = {}
    read_conf(path, conf)
    # a plan file (sabha.pro.conf ...) carries the roster, panes, copies and labels: SABHA_PLAN_DIR, else beside
    # sabha.conf, else beside the scripts (a conf in its sabha folder has no plan file next to it)
    plan = os.environ.get("SABHA_PLAN") or conf.get("SABHA_PLAN")
    if plan:
        name = "sabha.%s.conf" % plan
        pdir = os.environ.get("SABHA_PLAN_DIR") or os.path.dirname(path)
        if not os.environ.get("SABHA_PLAN_DIR") and not os.path.exists(os.path.join(pdir, name)):
            pdir = here
        ppath = os.path.join(pdir, name)
        if not os.path.exists(ppath):
            sys.exit("sabha-for-me: no plan file at %s (plans: pro, max5, max20)" % ppath)
        read_conf(ppath, conf)
    # the team's committed .sabha/config, then sabha.conf again so a key you set yourself wins (sabha_conf_read)
    shared = os.path.join(conf.get("SABHA_SHARED", ""), "config")
    if conf.get("SABHA_SHARED") and os.path.exists(shared):
        conf.update(read_shared(shared))
        read_conf(path, conf)
    apply_theme(conf, os.path.dirname(os.path.abspath(__file__)))
    for need in ("SABHA_IMPL", "SABHA_ROSTER"):
        if need not in conf:
            sys.exit("sabha-for-me: %s missing from %s" % (need, path))
    return conf


def apply_theme(conf, bindir):
    """Display data per role id from bin/sabha-theme resolve (the one parser): SABHA_NAME_, SABHA_COLOR_ and SABHA_ICON_
    <RoleId>. Roles keep their ids; the theme only says what is shown. read_conf has put SABHA_THEME in os.environ."""
    p = subprocess.run([os.environ.get("BASH") or "bash", os.path.join(bindir, "sabha-theme"), "resolve"], stdout=subprocess.PIPE,
                       stderr=subprocess.PIPE, universal_newlines=True)
    if p.returncode != 0:
        if os.environ.get("SABHA_THEME"):
            sys.exit("sabha-for-me: %s" % p.stderr.strip())
        return
    for line in p.stdout.splitlines():
        rid, name, color, icon = (line.split("|") + ["", "", "", ""])[:4]
        conf["SABHA_NAME_" + rid], conf["SABHA_COLOR_" + rid] = name, color
        # icons/<stem>.png beside bin/; a theme without the file shows the colour dot
        path = os.path.join(bindir, "..", "icons", icon + ".png")
        if os.path.exists(path):
            conf["SABHA_ICON_" + rid] = pathlib.Path(os.path.abspath(path)).as_uri()


def read_conf(path, conf):
    for raw in open(path, encoding="ascii", errors="replace"):
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        v = v.strip().strip('"').strip("'")
        # earlier keys and the environment both expand, so SABHA_IMPL can be written as $SABHA_WS/...
        os.environ[k.strip()] = win_path(os.path.expanduser(os.path.expandvars(v)))
        conf[k.strip()] = os.environ[k.strip()]


SHARED_KEYS = ("SABHA_PROJECT", "SABHA_ROSTER", "SABHA_PANES", "SABHA_MAX_COPIES", "SABHA_TRACKER", "SABHA_SHEET_ID")
SHARED_PREFIXES = ("SABHA_LABEL_", "SABHA_PROMPT_")


def read_shared(path):
    """The shared keys of a committed .sabha/config, parsed and never expanded: a pull request can change that file
    (same rule as sabha_shared_read in sabha-lib.sh). Personal keys are skipped."""
    out = {}
    for raw in open(path, encoding="utf-8", errors="replace"):
        line = raw.strip()
        if line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        k = k.strip()
        if k in SHARED_KEYS or k.startswith(SHARED_PREFIXES):
            v = v.strip()
            if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
                v = v[1:-1]
            out[k] = v
    return out


def win_path(v):
    # Git Bash writes /tmp/x and /c/x; native Windows Python reads those as C:\tmp\x. cygpath knows the mounts.
    if os.name != "nt" or not v.startswith("/"):
        return v
    try:
        return subprocess.run(["cygpath", "-w", v], capture_output=True, text=True, check=True).stdout.strip() or v
    except (OSError, subprocess.CalledProcessError):
        return v


AGENTS = ("claude", "opencode", "codex", "agy", "muse")


def roster_row(entry):
    """Name:agent:model[:effort[:flags]] -> [name, model, effort, flags, agent]; a second field that is no
    agent is the model (the older Name:model[:effort[:flags]] row), as sabha-lib.sh reads it."""
    f = entry.split(":")
    if len(f) > 1 and f[1] in AGENTS:
        agent, rest = f[1], f[2:]
    else:
        agent, rest = "claude", f[1:]
    return [f[0]] + rest[:3] + [""] * (3 - len(rest[:3])) + [agent]


def split_blocks(text):
    """Blocks are the runs of lines between lines that are exactly '---' (the file has one '---'
    before each block). A block written without its '---' is still split: an 'id:' line outside a
    cmd: body, in a block that already has one, starts a new block. A last block that does not end in
    a newline is still being written: it is left out until the write finishes."""
    blocks, cur = [], []
    has_id = in_cmd = False
    for line in text.split("\n"):
        if line == "---":
            blocks.append(cur)
            cur, has_id, in_cmd = [], False, False
            continue
        if not in_cmd and line.startswith("id:"):
            if has_id:
                blocks.append(cur)
                cur, in_cmd = [], False
            has_id = True
        elif line.startswith("cmd:"):
            in_cmd = True
        cur.append(line)
    if text.endswith("\n"):
        blocks.append(cur)
    return blocks


def parse_items(path):
    """'cmd:' takes every following line of the block, byte for byte. Later blocks with the same
    id override only the keys they carry, so closing an item is an appended block."""
    items, order = {}, []
    if not os.path.exists(path):
        return []
    text = open(path, encoding="ascii", errors="replace").read()
    for block in split_blocks(text):
        rec, cmd, in_cmd = {}, [], False
        for line in block:
            if in_cmd:
                cmd.append(line)
                continue
            m = re.match(r"^([a-z]+):\s?(.*)$", line)
            if m and m.group(1) == "cmd":
                in_cmd = True
                if m.group(2):
                    cmd.append(m.group(2))
            elif m:
                rec[m.group(1)] = m.group(2).strip()
        if cmd:
            rec["cmd"] = "\n".join(cmd).strip("\n")
        if "id" not in rec:
            continue
        iid = rec["id"]
        if iid not in items:
            items[iid] = {"added": rec.get("utc", "")}
            order.append(iid)
        if "state" in rec:
            items[iid]["changed"] = rec.get("utc", "")
        items[iid].update(rec)
    return [items[i] for i in order]


def question_of(i):
    """(question, explain, ask, rec, [(letter, text, consequence, example)]) for a question item, else None."""
    opts = []
    for L in "abcdefgh":
        raw = i.get("opt" + L)
        if raw:
            parts = [x.strip() for x in raw.split("|")] + ["", ""]
            opts.append((L.upper(), parts[0], parts[1], parts[2]))
    if not i.get("q") or not opts:
        return None
    return i["q"], i.get("explain", ""), i.get("ask", ""), i.get("rec", "").upper(), opts


def status_of(impl, name):
    path = os.path.join(impl, "status", name.lower() + ".md")
    ctx_path = os.path.join(impl, "status", "context", name.lower() + ".txt")
    # a closed tab leaves its last percent behind: older than STALE_MIN is no reading at all
    have = os.path.exists(ctx_path)
    fresh = have and (time.time() - os.path.getmtime(ctx_path)) / 60 <= STALE_MIN
    raw = clean_ctx(open(ctx_path).read()) if have else ""
    ctx = raw if fresh else ""
    # the chart keeps an old reading, drawn grey with the time it was last seen
    old = {"old": raw if raw and not fresh else "",
           "seen": time.strftime("%H:%M", time.localtime(os.path.getmtime(ctx_path))) if raw and not fresh else ""}
    if not os.path.exists(path):
        return {"task": "", "next": "", "age": None, "ctx": ctx, "idle": "", "current": "", "blocked": "", **old}
    text = open(path, encoding="utf-8", errors="replace").read()
    lines = text.splitlines()
    head = lines[:HEAD_LINES]
    current = next((l[8:].strip() for l in head if l.startswith("Current:")), "")
    idle = next((l[5:].strip() for l in head if l.startswith("Idle:")), "")
    blocked = next((l[8:].strip() for l in head if l.startswith("Blocked:")), "")
    task = current or idle or next((l[5:].strip() for l in lines if l.startswith("Task:")), "")
    # the newest handoff sits on top: the In flight line is the first Next: after Current:
    cur_at = next((n for n, l in enumerate(head) if l.startswith("Current:")), -1)
    nexts = [l[5:].strip() for l in lines[cur_at + 1:] if l.startswith("Next:")] if cur_at >= 0 else []
    nexts = nexts or [l[5:].strip() for l in lines if l.startswith("Next:")]
    age = (time.time() - os.path.getmtime(path)) / 60
    return {"task": task, "next": nexts[0] if nexts else "", "age": age, "ctx": ctx,
            "idle": idle, "current": current, "blocked": blocked, **old}


def state_of(s):
    if s["age"] is None:
        return "unknown"
    if s["idle"]:
        return "idle"
    if s["blocked"]:
        return "blocked"
    if s["current"] and s["age"] <= BUSY_MIN:
        return "busy"
    return "idle"


def clean_ctx(raw):
    """The context percent is shown only when it parses as a number from 0 to 100."""
    try:
        v = float(raw)
    except ValueError:
        return ""
    return raw.strip() if 0 <= v <= 100 else ""


def is_closed(item):
    return item.get("state") in ("DONE", "DROPPED")


def local_day(stamp):
    """The local calendar day of a utc stamp such as 2026-10-13T10:09:13Z."""
    try:
        t = dt.datetime.strptime(stamp, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=dt.timezone.utc)
    except ValueError:
        return ""
    return t.astimezone().strftime("%Y-%m-%d")


def ascii(s):
    return s.encode("ascii", "replace").decode("ascii")


def short(s, n=160):
    s = " ".join(s.split())
    return s if len(s) <= n else s[: n - 3] + "..."


def age_text(a):
    if a is None:
        return "-"
    return "%dm" % a if a < 120 else "%.1fh" % (a / 60)


def rel_time(stamp):
    """'2h ago' for a utc stamp; the raw text when it does not parse."""
    try:
        t = dt.datetime.strptime(stamp, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=dt.timezone.utc)
    except ValueError:
        return stamp
    m = max(0, int((dt.datetime.now(dt.timezone.utc) - t).total_seconds() // 60))
    return "just now" if m < 1 else "%dm ago" % m if m < 60 else "%dh ago" % (m // 60) if m < 2880 else "%dd ago" % (m // 1440)


def ist_text(stamp):
    """The utc stamp in IST, for hover text; the raw text when it does not parse."""
    try:
        t = dt.datetime.strptime(stamp, "%Y-%m-%dT%H:%M:%SZ") + dt.timedelta(hours=5, minutes=30)
    except ValueError:
        return stamp
    return t.strftime("%Y-%m-%d %H:%M IST")


def parse_goals(path):
    """GOALS.md headings "## title [P0] (owner: X; helpers: A, B) {state: paused}" with "- [x] step [@Name]" lines."""
    goals = []
    try:
        lines = open(path, encoding="utf-8").read().splitlines()
    except OSError:
        return goals
    for ln in lines:
        if ln.startswith("## "):
            t = ln[3:].strip()
            pri = re.search(r"\[(P[0-2])\]", t)
            own = re.search(r"\(([^()]*(?:owner|helpers):[^()]*)\)", t)
            st = re.search(r"\{\s*state:\s*(active|paused|done)\s*\}", t, re.I)
            f = dict(re.findall(r"(owner|helpers):\s*([^;]*)", own.group(1))) if own else {}
            for m in (pri, own, st):
                if m:
                    t = t.replace(m.group(0), "")
            goals.append(dict(title=re.sub(r"\s+", " ", t).strip(), steps=[], pri=pri.group(1) if pri else "P2",
                              owner=f.get("owner", "").strip() or "unassigned",
                              helpers=[h.strip() for h in f.get("helpers", "").split(",") if h.strip()],
                              state=st.group(1).lower() if st else ""))
        m = re.match(r"\s*- \[([ xX])\] (.*)", ln)
        if m and goals:
            goals[-1]["steps"].append((m.group(1) != " ", m.group(2).strip()))
    for g in goals:
        if not g["state"]:
            g["state"] = "done" if g["steps"] and all(d for d, _ in g["steps"]) else "active"
    return goals


def step_agent(t):
    m = re.search(r"\s@([A-Za-z]+)\s*$", t)
    return (t[:m.start()], m.group(1)) if m else (t, "")


def agent_goals(b, name):
    """Titles of the active goals this agent owns, helps, or is named on in an open step."""
    n = name.lower()
    return [g["title"] for g in b["goals"] if g["state"] == "active" and (
        g["owner"].lower() == n or n in [h.lower() for h in g["helpers"]]
        or any(not d and step_agent(t)[1].lower() == n for d, t in g["steps"]))]


def build(conf):
    impl = conf["SABHA_IMPL"]
    roster = [roster_row(r) for r in conf["SABHA_ROSTER"].split()]
    waiting_people = conf.get("SABHA_WAITING", "").split()
    items = parse_items(os.path.join(impl, "for-me.items"))
    now = dt.datetime.now(dt.timezone.utc)
    today = dt.datetime.now().strftime("%Y-%m-%d")
    open_items = [i for i in items if not is_closed(i) and not i.get("waiting")]
    waiting = [i for i in items if not is_closed(i) and i.get("waiting")]
    done = [i for i in items if is_closed(i) and local_day(i.get("changed", "")) == today]
    fallback = {}
    for pair in conf.get("SABHA_TASK_FALLBACK", "").split(";"):
        if "=" in pair:
            k, v = pair.split("=", 1)
            fallback[k.strip()] = v.strip()
    agents = []
    known = {r[0].lower() for r in roster}
    sdir = os.path.join(impl, "status")
    # a role with a status file but no roster row still gets a table row
    for f in sorted(os.listdir(sdir)) if os.path.isdir(sdir) else []:
        if re.fullmatch(r"[A-Za-z]+\.md", f) and f[:-3].lower() not in known:
            roster.append([f[:-3].capitalize()])
    for entry in roster:
        name, model = entry[0], (entry[1] if len(entry) > 1 else "")
        effort = entry[2] if len(entry) > 2 else ""
        s = status_of(impl, name)
        if not s["current"] and not s["idle"] and name in fallback:
            s["task"] = fallback[name]
        stale = s["age"] is not None and s["age"] > STALE_MIN and not s["idle"]
        agents.append(dict(name=name, display=conf.get("SABHA_NAME_" + name, name), model=model, effort=effort, flags=entry[3] if len(entry) > 3 else "",
                           agent=entry[4] if len(entry) > 4 else "claude", label=conf.get("SABHA_LABEL_" + name, ""),
                           icon=conf.get("SABHA_ICON_" + name, ""),
                           color=conf.get("SABHA_COLOR_" + name, "") if re.match(r"^#[0-9A-Fa-f]{6}$", conf.get("SABHA_COLOR_" + name, "")) else "",
                           state=state_of(s), stale=stale, **s))
    return dict(inbox=parse_inboxes(impl), now=now.strftime("%Y-%m-%d %H:%M:%SZ"), items=items, open=open_items, waiting=waiting, waiting_people=waiting_people,
                done=done, agents=agents, epoch=int(time.time()), project=conf.get("SABHA_PROJECT", ""), goals=parse_goals(os.path.join(impl, "GOALS.md")))


def shown(a):
    """The name to display: the theme's character, with the role id in brackets when they differ."""
    return a["display"] if a["display"] == a["name"] else "%s (%s)" % (a["display"], a["name"])


def role_mark(a):
    """The theme's icon for a role, else its colour dot, else nothing."""
    if a.get("icon"):
        return "<img class=ri src=\"%s\" width=20 height=20 alt=\"\" onerror=\"this.remove()\"> " % html.escape(a["icon"])
    if a.get("color"):
        return "<span style=\"color:%s\">&#9679;</span> " % a["color"]
    return ""


def state_label(a):
    if a["age"] is None:
        return "not running"
    return "stale" if a["stale"] and a["state"] != "blocked" else a["state"]


def ctx_text(a):
    if a["ctx"]:
        return a["ctx"]
    return "%s (last seen %s, not running)" % (a["old"], a["seen"]) if a.get("old") else "-"


def qcard(i):
    """The question card (radios, rec, examples, free text, Copy answer) for an item; '' for a plain item."""
    e = html.escape
    qq = question_of(i)
    if not qq:
        return ""
    q, ex, ask, rec, opts = qq
    who = ask or i.get("waiting", "")
    # the board owner comes from sabha.conf (SABHA_USER) so nothing personal is baked into the tree
    other = bool(who) and who.lower() != os.environ.get("SABHA_USER", "Owner").lower()
    qid = "q" + re.sub(r"[^A-Za-z0-9]", "_", i["id"])
    p = ["<form class=qa data-id='%s' onsubmit='return false'>" % e(i["id"], quote=True)]
    if who:
        p.append("<div class=need%s><b>Needs: %s</b></div>" % (tip("card-question", False), e(who)))
    if " ".join(q.lower().split()) != " ".join(i.get("title", "").lower().split()):
        p.append("<div class=qq>%s</div>" % e(q))
    if ex:
        p.append("<div class=why><span class=k>why it matters</span> %s</div>" % e(ex))
    for L, t, c, x in opts:
        p.append("<label class=opt><input type=radio name=%s value=%s data-t='%s'><span><b>%s) %s</b>%s%s%s</span></label>" % (
            qid, L, e(t, quote=True), L, e(t), " <i class=rec>(Recommended)</i>" if L == rec else "",
            "<br><span class=k>%s</span>" % e(c) if c else "", "<br><span class=ex>e.g. %s</span>" % e(x) if x and not x.lower().startswith("you reply") else ""))
    if other:
        p.append("<input type=text class=by placeholder='Answered by (e.g. %s), optional' aria-label='Answered by'>" % e(who, quote=True))
    p.append("<textarea rows=2 placeholder='Or type your own answer' aria-label='Or type your own answer'></textarea>"
             "<button type=button%s class='ans primary' disabled>Copy answer</button> <span class=k></span></form>" % tip("copy-answer", False))
    return "".join(p)


LANES = (("P0", "Now"), ("P1", "Next"), ("P2", "Later"))


def render_md(b):
    out = ["# FOR-ME (generated %s, do not edit; source: for-me.items, status/)" % b["now"], ""]
    mv = ["## Your move", ""]
    if not b["open"]:
        mv.append("Nothing open.")
    for i in b["open"]:
        mv.append("### %s. %s  (%s, %s)" % (i["id"], i.get("title", ""), i.get("owner", "?"), i.get("added", "")))
        for k in ("why", "unblocks"):
            if i.get(k):
                mv.append("- %s: %s" % (k, i[k]))
        qq = question_of(i)
        if qq:
            q, ex, ask, rec, opts = qq
            mv.append("- question%s: %s" % (" (answer: %s)" % ask if ask else "", q))
            if ex:
                mv.append("- why it matters: %s" % ex)
            for L, t, c, x in opts:
                mv.append("  %s) %s%s%s%s" % (L, t, " (Recommended)" if L == rec else "",
                                               " - " + c if c else "", " e.g. " + x if x else ""))
            mv.append("- reply: Answer %s: <letter> - <option text>, or type your own" % i["id"])
        if i.get("cmd"):
            mv += ["", "```", i["cmd"], "```"]
        mv.append("")
    out += ["## Agents", "", "| Agent | Model | State | Goal | Task | Next | Ctx % | Updated |", "| --- | --- | --- | --- | --- | --- | --- | --- |"]
    for a in b["agents"]:
        out.append("| %s | %s | %s | %s | %s | %s | %s | %s |" % (
            shown(a) + (" (%s)" % a["label"] if a.get("label") and a["label"] != a["name"] else ""), (a["model"] + " " + a["effort"]).strip(), state_label(a),
            short("; ".join(agent_goals(b, a["name"])), 60).replace("|", "/") or "-", short(a["task"], 90).replace("|", "/"),
            short(a["next"], 70).replace("|", "/") or "-", ctx_text(a), age_text(a["age"])))
    out.append("")
    out += ["## Goals", ""]
    for key, label in LANES:
        gs = [g for g in b["goals"] if g["state"] == "active" and g["pri"] == key]
        out += ["### %s %s" % (key, label), ""]
        out += ["- (none)"] if not gs else ["- %s: %d/%d (owner: %s%s)" % (
            g["title"], sum(d for d, _ in g["steps"]), len(g["steps"]), g["owner"],
            "; helpers: " + ", ".join(g["helpers"]) if g["helpers"] else "") for g in gs]
        out.append("")
    for st, label in (("paused", "Paused"), ("done", "Done goals")):
        gs = [g for g in b["goals"] if g["state"] == st]
        if gs:
            out += ["### %s" % label, ""] + ["- %s: %d/%d (%s, owner: %s)" % (
                g["title"], sum(d for d, _ in g["steps"]), len(g["steps"]), g["pri"], g["owner"]) for g in gs] + [""]
    out += [""] + mv
    out += ["", "## In flight", ""]
    for a in b["agents"]:
        if a["state"] in ("busy", "blocked") and a["next"]:
            out.append("- %s (%s): %s" % (shown(a), a["state"], short(a["next"])))
    out += ["", "## Waiting for others (%s)" % ", ".join(b["waiting_people"]), ""]
    for i in b["waiting"]:
        out.append("- %s. [%s] %s" % (i["id"], i["waiting"], i.get("title", "")))
        qq = question_of(i)
        if qq:
            q, ex, ask, rec, opts = qq
            out.append("  - question (needs: %s): %s" % (ask or i["waiting"], q))
            for L, t, c, x in opts:
                out.append("    %s) %s%s%s%s" % (L, t, " (Recommended)" if L == rec else "",
                                                 " - " + c if c else "", " e.g. " + x if x else ""))
    if not b["waiting"]:
        out.append("Nothing recorded.")
    out += ["", "## Done today (%d)" % len(b["done"]), ""]
    for i in b["done"]:
        out.append("- %s. %s: %s" % (i["id"], i.get("state"), i.get("title", "")))
    out += inbox_md(b.get("inbox", {}))
    return ascii("\n".join(out) + "\n")


