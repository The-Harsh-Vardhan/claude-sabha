STATE_ORDER = {"blocked": 0, "busy": 1, "idle": 2, "unknown": 3}


def model_class(m):
    m = m.lower()
    return next((k for k in ("fable", "opus", "sonnet", "haiku") if k in m), "")


def render_html(b):
    e = html.escape
    _TIPS.clear()
    _TIPS.update({el[6:]: t["text"] for t in load_tips() for el in t["surfaces"] if el.startswith("board:")})
    agents = b["agents"]
    # one bucket per agent, by the label the table shows, so tiles, In flight and the table cannot disagree
    cnt = lambda st: sum(1 for a in agents if state_label(a) == st)
    stale = cnt("stale")
    flight = [a for a in agents if state_label(a) in ("busy", "blocked")]
    steps = [x for g in b["goals"] for x, _ in g["steps"]]
    p = ['<!doctype html><html lang=en><head><meta charset="utf-8">',
         '<noscript><meta http-equiv="refresh" content="15"></noscript>',
         '<meta name="viewport" content="width=device-width,initial-scale=1"><title>%s</title>' % ("(%d) Sabha - %d for you" % (len(b["open"]), len(b["open"])) if b["open"] else "Sabha board"),
         "<script src='https://cdn.jsdelivr.net/npm/chart.js@4.5.1' integrity='sha384-jb8JQMbMoBUzgWatfe6COACi2ljcDdZQ2OxczGA3bGNeWe+6DChMTBJemed7ZnvJ' crossorigin='anonymous'></script>"
         "<style>%s</style><script>%s</script></head><body data-gen=%d><div class=wrap>" % (CSS, JS, b["epoch"]),
         "<header><h1>Sabha</h1><span class=sub>%s</span>" % e(b.get("project", "")),
         '<div id=live class=live><i class=dot></i><span>generated %s</span></div><button id=pause type=button>Pause</button></header>' % e(b["now"])]
    # the tiles partition the agents, so they add up to the table and to In flight
    kp = [("Your move", len(b["open"]), "hot" if b["open"] else "", "your-move"), ("Busy", cnt("busy"), "blue", "flight"),
          ("Blocked", cnt("blocked"), "hot" if cnt("blocked") else "", "flight"), ("Stale", stale, "warm" if stale else "", "agents"),
          ("Idle", len(agents) - cnt("busy") - cnt("blocked") - stale, "", "agents"), ("Goal steps", "%d/%d" % (sum(steps), len(steps)), "", "goals")]
    p.append("<div class=kpis>" + "".join("<a class='kpi %s' href=#%s><div class=n>%s</div><div class=l>%s</div></a>" % (c, h, e(str(n)), l)
                                           for l, n, c, h in kp) + "</div>")
    move = ["<section id=your-move><h2%s>Your move <span class=c>%d</span></h2>" % (tip("your-move"), len(b["open"]))]
    if not b["open"]:
        move.append("<div class='card empty'>Nothing needs you.</div>")
    for n, i in enumerate(b["open"]):
        move.append("<div class='card move' style='margin-bottom:10px'><div class=t>%s. %s</div><div class=meta title='%s'>%s, %s</div>" % (
            e(i["id"]), e(i.get("title", "")), e(ist_text(i.get("added", "")), quote=True), e(i.get("owner", "?")), e(rel_time(i.get("added", "")))))
        for k in ("why", "unblocks"):
            if i.get(k):
                move.append("<div class=row><span class=k>%s</span> %s</div>" % (k, e(i[k])))
        move.append(qcard(i))
        if i.get("cmd"):
            move.append("<div class=cmd><pre id=c%d>%s</pre><button type=button onclick=\"cp('c%d',this)\">Copy</button></div>" % (n, e(i["cmd"]), n))
        move.append("</div>")
    move.append("</section>")
    p.append("".join(move))
    def cnum(a):
        try:
            return float(a["ctx"] or a.get("old") or "x")
        except (TypeError, ValueError):
            return None
    data = dict(agents=[dict(name=a["display"], ctx=cnum(a), old=bool(a.get("old")), seen=a.get("seen", ""), st="stale" if a["stale"] and a["state"] != "blocked" else a["state"]) for a in agents],
                goals=[dict(t=g["title"], n=len(g["steps"]), d=sum(x for x, _ in g["steps"])) for g in b["goals"]])
    p.append("<script type=application/json id=sabha-data>%s</script>" % json.dumps(data).replace("</", "<\\/"))
    p.append("<section id=agents><h2%s>Agents <span class=c>%d</span></h2><div class=atw><table class=at><thead><tr><th%s>Agent</th><th%s>Model / effort</th><th%s>State</th><th%s>Goal</th><th%s>Task</th><th%s>Next</th><th%s>Context %%</th><th%s>Last update</th></tr></thead><tbody>" % (
        (tip("agents"), len(agents)) + tuple(tip("col-" + k, False) for k in ("agent", "model", "state", "goal", "task", "next", "ctx", "updated"))))
    for a in sorted(agents, key=lambda a: (STATE_ORDER.get(a["state"], 9), a["stale"])):
        sl = state_label(a)
        if a["ctx"]:
            cx = "<span class='cx %s'>%s%%</span>" % ("b" if float(a["ctx"]) >= 30 else "w" if float(a["ctx"]) >= 20 else "", e(a["ctx"]))
        elif a.get("old"):
            cx = "<span class='cx old' title='last seen %s, not running'>%s%% <span class=k>last seen %s</span></span>" % (e(a["seen"]), e(a["old"]), e(a["seen"]))
        else:
            cx = "<span class=k>-</span>"
        p.append("<tr><td class=nm>%s</td><td><span class='chip %s'>%s</span> <span class=k>%s</span></td><td><span class='st %s'%s>%s</span></td>"
                 "<td>%s</td><td>%s</td><td>%s</td><td class=mono>%s</td><td class=mono>%s</td></tr>" % (
                     role_mark(a) + e(a["display"]) + (" <span class=k title=\"role id\">(%s)</span>" % e(a["name"]) if a["display"] != a["name"] else "") + (" <span class=k>(%s)</span>" % e(a["label"]) if a.get("label") and a["label"] != a["name"] else ""), model_class(a["model"]), e(a["model"]), e(a["effort"]), sl.replace(" ", ""), tip("state-" + sl.replace(" ", "-")), e(sl),
                     e("; ".join(agent_goals(b, a["name"]))) or "<span class=k>-</span>", e(short(a["task"], 160)) or "<span class=k>-</span>", e(short(a["next"], 160)) or "<span class=k>-</span>", cx, age_text(a["age"])))
    p.append("</tbody></table></div></section>")
    p.append("<div class=charts><div class=card><h3>Context per agent</h3><div class=cv><canvas id=ch-ctx aria-label='Context percent per agent'></canvas></div><div class=k>grey = no reading in 30 min</div></div>"
             "<div class=card><h3>Agent states</h3><div class=cv><canvas id=ch-state aria-label='Agents by state'></canvas></div></div>"
             "<div class=card><h3>Goal steps</h3><div class=cv><canvas id=ch-goals aria-label='Done and open steps per goal'></canvas></div></div></div>")
    def gcard(gi, g):
        n, d = len(g["steps"]), sum(x for x, _ in g["steps"])
        pc = 100 * d // n if n else 0
        nxt, ag = next((step_agent(t) for x, t in g["steps"] if not x), ("", ""))
        chips = "<span class='chip own'>%s</span>" % e(g["owner"]) + "".join("<span class='chip help'>%s</span>" % e(h) for h in g["helpers"])
        r = ["<div class='card goal %s'><div class=top><b>%s</b><span class=pct>%d/%d</span></div><div class=chips>%s</div>"
             "<div class=bar><i style='width:%d%%'></i></div>" % (g["pri"], e(g["title"]), d, n, chips, pc)]
        r.append("<div class=next><span class=k>next:</span> %s%s</div>" % (e(nxt), " <span class='chip help'>@%s</span>" % e(ag) if ag else "") if nxt else
                 "<div class=next style='color:var(--ok)'>All %d steps done</div>" % n)
        r.append("<details id=g%d><summary>All steps</summary>%s</details></div>" % (gi, "".join(
            "<div class='step%s'><span class=m>%s</span><span>%s</span></div>" % (" d" if x else "", "&#10003;" if x else "&#9675;", e(t))
            for x, t in g["steps"])))
        return "".join(r)
    gl = list(enumerate(b["goals"]))
    lanes = [(key, label, [gcard(i, g) for i, g in gl if g["state"] == "active" and g["pri"] == key]) for key, label in LANES]
    p.append("<span id=goals></span><h2%s>Goals %s</h2><div class=lanes>" % (tip("goals"), "".join(
        "<span class=chip>%s %s: none</span>" % (k, l) for k, l, cs in lanes if not cs)))
    for key, label, cs in lanes:
        if cs:
            p.append("<div class='lane lane-%s'><h3>%s <span class=k>%s</span> <span class=c>%d</span></h3>%s</div>" % (
                key, key, label, len(cs), "".join(cs)))
    p.append("</div>")
    if not b["goals"]:
        p.append("<div class=empty>No GOALS.md in the impl folder.</div>")
    for st, label in (("paused", "Paused"), ("done", "Done goals")):
        gs = [(i, g) for i, g in gl if g["state"] == st]
        if gs:
            p.append("<details class=strip id=s-%s><summary>%s <span class=c>%d</span></summary><div class=lanes>%s</div></details>" % (
                st, label, len(gs), "".join(gcard(i, g) for i, g in gs)))
    p.append("<span id=flight></span><h2%s>In flight <span class=c>%d</span></h2><div class=flight>" % (tip("in-flight"), len(flight)))
    p.append("".join("<div class=card><b>%s</b><span class='st %s' style='margin:0 6px 0 0'>%s</span>%s</div>" % (
        e(a["display"]), a["state"], a["state"], e(short(a["next"] or a["task"], 400))) for a in flight) or "<div class=empty>Nobody busy.</div>")
    p.append("</div><h2%s>Waiting for others <span class=c>%d</span><span style='text-transform:none;letter-spacing:0'>%s</span></h2>" % (
        tip("waiting"), len(b["waiting"]), e(", ".join(b["waiting_people"]))))
    p.append("".join("<div class=card style='margin-bottom:8px'><b>%s. %s</b> <span class=k>waiting on %s</span>%s</div>" % (
        e(i["id"]), e(i.get("title", "")), e(i["waiting"]), qcard(i)) for i in b["waiting"]) or "<div class=empty>Nothing recorded.</div>")
    p.append("<h2%s>Done today <span class=c>%d</span></h2><details id=done><summary>Show</summary>" % (tip("done-today"), len(b["done"])))
    p.append("".join("<div class='step d'><span class=m>&#10003;</span><span>%s. %s</span></div>" % (e(i["id"]), e(i.get("title", ""))) for i in b["done"]))
    p.append("</details>")
    p.append(inbox_html(b.get("inbox", {})))
    p.append("</div>")
    p.append("</body></html>")
    return ascii("\n".join(p) + "\n")


_NOISE = re.compile(r"^(?:(?:done|utc):\s*)?\d{4}-\d\d-\d\dT[\d:]+Z?$|^(?:to|from|brief|utc):", re.I)


def marker_line(path, prefer):
    """First useful line of a marker file: skip bare timestamps and routing headers, favour `prefer:`."""
    try:
        lines = [l.strip() for l in open(path, encoding="utf-8", errors="replace") if l.strip()]
    except OSError:
        return ""
    for l in lines:
        if l.lower().startswith(prefer + ":"):
            return short(l[len(prefer) + 1:].strip() or l, 140)
    return short(next((l for l in lines if not _NOISE.match(l)), ""), 140)


def parse_inboxes(impl):
    """One dict per brief NNN-<from>-<slug>.md under inbox/<Name>/, newest first per agent."""
    root = os.path.join(impl, "inbox")
    out = {}
    for name in sorted(os.listdir(root)) if os.path.isdir(root) else []:
        d = os.path.join(root, name)
        if not os.path.isdir(d):
            continue
        try:
            files = set(os.listdir(d))
        except OSError:
            continue
        rows = []
        for f in sorted(files):
            m = re.match(r"(\d+)-([^-]+)-(.*)\.md$", f)
            if not m:  # e.g. tutor-001-*.md in Relay is not a numbered brief
                continue
            n, frm, slug = m.groups()
            path = os.path.join(d, f)
            if not os.path.isfile(path):
                continue
            try:
                with open(path, encoding="utf-8", errors="replace") as fh:
                    head = [l.strip() for l in fh.read(4000).splitlines()]
                mtime = os.path.getmtime(path)
            except OSError:
                continue
            fm = {k.lower(): v.strip() for k, _, v in (l.partition(":") for l in head[:12]) if k.isalpha()}
            mt = dt.datetime.fromtimestamp(mtime, dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
            created = fm["utc"] if re.match(r"\d{4}-\d\d-\d\dT", fm.get("utc", "")) else mt
            # the task: line says more than the slug; fall back to a heading, then the slug
            title = fm.get("task") or next((l.lstrip("# ") for l in head if l.startswith("#")), "") or slug.replace("-", " ")
            has = lambda x: "%s.%s" % (n, x) in files
            st = ("done" if has("done") else "cancelled" if has("cancel") else "blocked" if has("blocked")
                  else "acked" if has("ack") else "claimed" if has("claim") else "open")
            mk = {"done": ("done", "done"), "cancelled": ("cancel", "reason"), "blocked": ("blocked", "status")}.get(st)
            rows.append(dict(agent=name, brief=n, title=short(title, 140), frm=fm.get("from") or frm, created=created, state=st,
                             outcome=marker_line(os.path.join(d, "%s.%s" % (n, mk[0])), mk[1]) if mk else "",
                             path="inbox/%s/%s" % (name, f)))
        rows.sort(key=lambda r: (r["created"], r["brief"]), reverse=True)
        out[name] = rows
    return out


def inbox_html(inb):
    e = html.escape
    chips = {"open": "busy", "claimed": "stale", "acked": "stale", "blocked": "blocked", "done": "ok", "cancelled": "idle"}
    def row(r):
        return ("<div class=ib><span class='st %s'>%s</span><span class=m>%s</span><span><b>%s</b> <span class=k>from %s, %s</span>%s</span></div>" % (
            chips[r["state"]], r["state"], e(r["brief"]), e(r["title"]), e(r["frm"]), e(r["created"][:16].replace("T", " ")),
            "<div class=k>%s</div>" % e(r["outcome"]) if r["outcome"] else ""))
    p = ["<section id=inboxes><h2%s>Inboxes <span class=c>%d open</span></h2>" % (tip("inboxes"), sum(1 for rs in inb.values() for r in rs if r["state"] == "open"))]
    for name, rs in inb.items():
        live = [r for r in rs if r["state"] not in ("done", "cancelled")]
        gone = [r for r in rs if r["state"] in ("done", "cancelled")]
        nopen = sum(1 for r in rs if r["state"] == "open")
        p.append("<details class='card ibx'%s><summary><b>%s</b> <span class='chip%s'>%d open</span> <span class=k>%d total</span></summary>" % (
            " open" if live else "", e(name), " own" if nopen else "", nopen, len(rs)))
        p.append("".join(row(r) for r in live) + ("<details><summary>Done / cancelled (%d)</summary>%s</details>" % (
            len(gone), "".join(row(r) for r in gone)) if gone else ""))
        p.append("</details>")
    p.append("</section>")
    return "".join(p)


def inbox_md(inb):
    out = ["", "## Inboxes (open briefs)", ""]
    for name, rs in inb.items():
        live = [r for r in rs if r["state"] not in ("done", "cancelled")]
        if live:
            out.append("- %s (%d)" % (name, len(live)))
            out += ["  - %s %s [%s] from %s" % (r["brief"], r["title"], r["state"], r["frm"]) for r in live]
    return out


def write_atomic(path, text):
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".for-me-")
    with os.fdopen(fd, "w", encoding="ascii") as f:
        f.write(text)
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)


def inbox_open(impl, name):
    """Briefs NNN-<from>-<slug>.md in inbox/<Name>/ with neither NNN.done nor NNN.cancel."""
    d = os.path.join(impl, "inbox", name)
    try:
        files = set(os.listdir(d))
    except OSError:
        return 0
    nums = [m.group(1) for f in files for m in [re.match(r"(\d+)-.*\.md$", f)] if m]
    return sum(1 for n in nums if n + ".done" not in files and n + ".cancel" not in files)


def write_csv(path, header, rows):
    with open(path, "w", encoding="utf-8", newline="") as f:
        w = csv.writer(f, lineterminator="\r\n")  # RFC 4180
        w.writerow(header)
        # a leading = + - @ would run as a formula in Sheets
        w.writerows([("'" if re.match(r"[=+\-@]", c) else "") + c for c in (ascii(str(c)) for c in r)] for r in rows)


def export_csv(b, conf, outdir):
    """agents.csv, for-me.csv and inbox.csv from the data build() already parsed."""
    impl = conf["SABHA_IMPL"]
    os.makedirs(outdir, exist_ok=True)
    up = os.path.join(os.path.dirname(os.path.abspath(__file__)), "sabha-up.sh")
    rows = []
    for a in b["agents"]:
        pct = a["ctx"] or a.get("old") or ""
        upd = "" if a["age"] is None else dt.datetime.fromtimestamp(time.time() - a["age"] * 60).strftime("%Y-%m-%dT%H:%M:%S")
        rows.append([a["name"], a["model"], a["effort"], "/".join(a["flags"].split(",")) if a["flags"] else "", "", pct,
                     "" if not pct else "yes" if float(pct) > 30 else "no", state_label(a), short(a["task"], 200), upd,
                     inbox_open(impl, a["name"]), "%s %s" % (up, a["name"])])
    write_csv(os.path.join(outdir, "agents.csv"),
              ["Name", "Model", "Effort", "Flags", "Pane", "Context %", "Over 30%", "Status", "Current task", "Last update",
               "Inbox open", "Restart line"], rows)
    rows = []
    for i in b["items"]:
        qq = question_of(i)
        opts = " | ".join("%s: %s" % (L, t) for L, t, c, x in qq[4]) if qq else ""
        kind = i.get("kind") or ("question" if qq else "action" if i.get("cmd") else "info")
        st = "answered" if i.get("answer") and not is_closed(i) else i.get("state", "OPEN").lower()
        rows.append([i["id"], kind, i.get("title", ""), qq[1] if qq and qq[1] else i.get("why", ""), opts,
                     qq[3] if qq else i.get("rec", "").upper(), i.get("answer", ""), st, i.get("owner", ""),
                     i.get("added", ""), i.get("link") or i.get("source") or ""])
    write_csv(os.path.join(outdir, "for-me.csv"),
              ["ID", "Kind", "Title", "Explanation", "Options", "Recommended", "Answer", "Status", "Owner", "Created",
               "Link/source"], rows)
    write_csv(os.path.join(outdir, "inbox.csv"),
              ["Agent", "Brief", "Title", "From", "Created", "State", "Outcome", "Path"],
              [[r["agent"], r["brief"], r["title"], r["frm"], r["created"], r["state"], r["outcome"], r["path"]]
               for rs in b["inbox"].values() for r in rs])


def once(conf, csv_dir=None):
    b = build(conf)
    csv_dir = csv_dir or conf.get("SABHA_CSV_DIR")
    if csv_dir:
        export_csv(b, conf, csv_dir)
    out = conf.get("SABHA_FORME_DIR", conf["SABHA_IMPL"])
    write_atomic(os.path.join(out, "FOR-ME.md"), render_md(b))
    write_atomic(os.path.join(out, "FOR-ME.html"), render_html(b))


def selftest():
    """Asserts on synthetic inputs in a temp dir. Run as: sabha-for-me --selftest"""
    import shutil
    base = tempfile.mkdtemp(prefix="sabha-selftest-")
    try:
        os.makedirs(os.path.join(base, "status"))
        items = os.path.join(base, "for-me.items")
        cmd = "psql -U app -d mydb -f -\ntar -czf out.tgz -\ncat -\n--"
        with open(items, "w", encoding="ascii") as f:
            f.write("---\nid: 1\ntitle: stdin\nowner: test\nutc: 2026-10-13T10:00:00Z\ncmd: %s\n" % cmd)
            f.write("---\nid: 2\ntitle: torn\nutc: 2026-10-13T10:05:00Z\nstate: DO")
        parsed = parse_items(items)
        assert [i["id"] for i in parsed] == ["1"], "torn last block must be left out: %r" % [i["id"] for i in parsed]
        assert parsed[0]["cmd"] == cmd, "cmd must be byte-exact: %r" % parsed[0]["cmd"]
        with open(items, "a", encoding="ascii") as f:
            f.write("\n---\nid: 2\nutc: 2026-10-13T10:06:00Z\nstate: DONE\n")
        parsed = parse_items(items)
        assert [i["state"] for i in parsed if i["id"] == "2"] == ["DONE"], "closing block must complete item 2"
        assert split_blocks("---\na\n---\nb\n") == [[], ["a"], ["b", ""]], split_blocks("---\na\n---\nb\n")
        zed = os.path.join(base, "status", "zed.md")
        with open(zed, "w", encoding="ascii") as f:
            f.write("Title line\nNext: wait for BuilderPrecise's message\nNext: older handoff\n")
        s = status_of(base, "zed")
        assert s["next"] == "wait for BuilderPrecise's message", "first Next: in file: %r" % s["next"]
        assert state_of(s) == "idle", "a Next: with 'wait' must not be blocked: %r" % state_of(s)
        with open(zed, "w", encoding="ascii") as f:
            f.write("Title line\nCurrent: work\nNext: first after current\nNext: later\n")
        s = status_of(base, "zed")
        assert s["next"] == "first after current" and state_of(s) == "busy", (s["next"], state_of(s))
        with open(zed, "w", encoding="ascii") as f:
            f.write("Title line\nBlocked: needs the user\nNext: anything\n")
        assert state_of(status_of(base, "zed")) == "blocked", "Blocked: line is the only blocked state"
        assert clean_ctx("12.5") == "12.5" and clean_ctx("150") == "" and clean_ctx("junk") == ""
    finally:
        shutil.rmtree(base, ignore_errors=True)
    print("sabha-for-me: selftest ok")


def main():
    if sys.argv[1:2] and sys.argv[1] in ("--tips", "--tip-help", "--tip-of-day"):
        tips_cli(sys.argv[1:])
        return
    if "--selftest" in sys.argv[1:]:
        selftest()
        return
    conf = load_conf()
    argv = sys.argv[1:]
    csv_dir = None
    if "--csv" in argv:
        n = argv.index("--csv") + 1
        csv_dir = argv[n] if n < len(argv) and not argv[n].startswith("--") else conf.get("SABHA_CSV_DIR")
        if not csv_dir:
            sys.exit("sabha-for-me: --csv needs a directory or SABHA_CSV_DIR in sabha.conf")
    if "--watch" not in argv:
        once(conf, csv_dir)
        return
    while True:
        try:
            once(conf, csv_dir)
        except Exception as exc:  # a half-written status file must not kill the loop
            print("sabha-for-me: %s" % exc, file=sys.stderr)
        time.sleep(15)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
