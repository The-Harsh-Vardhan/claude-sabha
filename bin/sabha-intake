#!/usr/bin/env python3
"""sabha-intake: a meeting note or a Slack transcript (text) becomes a fact list, a decision list and one brief plus
one board row per ask. Nothing is sent anywhere; nothing is fetched.

  sabha-intake [--apply] [--dir DIR] [--to ROLE] [--from NAME] [FILE ...]
  FILE        a .txt or .md note. With no FILE, every .txt and .md in <dir>/drop is read. An image (a Slack screenshot)
              is not read by this tool: the model that looks at it writes a transcript next to it (shot.png -> shot.txt)
              in the note format below, and that transcript is the file.
  --apply     file the asks. Without it the tool only prints what it would do and writes nothing (dry run).
  --dir DIR   the intake folder (default SABHA_INTAKE_DIR, else <SABHA_IMPL>/intake): drop/, digests/, ledger.
  --to ROLE   the inbox that gets the briefs (default SABHA_INTAKE_TO, else Dispatcher).
  --from NAME the sender of the briefs and the owner of the board rows (default SABHA_INTAKE_FROM, else intake).

Note format: a heading line (Facts, Decisions, Asks; also Action items, Actions, TODO, Next steps; markdown # and a
trailing colon are fine) starts a section, and every line under it is one entry. A line that starts "Fact:",
"Decision:", "Ask:", "Action:" or "TODO:" is an entry of that kind wherever it stands. Leading bullets, numbers and
[ ] are dropped. Other lines are counted as skipped and never filed.

Per file with --apply: <dir>/digests/<name>-<hash>.md (the fact list, written once, never replaced), then per ask one
brief (bin/sabha-brief) and one for-me.items row (bin/sabha-item). <dir>/ledger records each filed ask by content
hash, so a rerun of the same note files nothing twice and a run that stopped half way continues where it stopped.
Exit 0 ok, 1 a file failed or held nothing, 2 usage.
"""
import hashlib
import importlib.machinery
import importlib.util
import os
import re
import subprocess
import sys
import tempfile
import time
import datetime as dt

sys.dont_write_bytecode = True
HERE = os.path.dirname(os.path.abspath(__file__))
MAX_READ = 1024 * 1024
TEXT_MAX = 300
MAX_ENTRIES = 200
LOCK_STALE = 120
OPTS = ("--dir", "--to", "--from")
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]*$")
KINDS = {"fact": "facts", "facts": "facts", "decision": "decisions", "decisions": "decisions", "ask": "asks",
         "asks": "asks", "action": "asks", "actions": "asks", "action item": "asks", "action items": "asks",
         "todo": "asks", "to-do": "asks", "to do": "asks", "next step": "asks", "next steps": "asks"}
KIND_RE = r"(facts?|decisions?|asks?|actions?|action items?|todo|to-do|to do|next steps?)"


def clean(s):
    """The one function every printed or written value goes through: printable ASCII, one line. Control characters
    (ESC, CR, NUL, DEL, newlines, the C1 range) become a space, every other non-ASCII character (bidi marks, line
    separators included) becomes '?'."""
    s = str(s)
    return " ".join("".join(c if " " <= c <= "~" else ("?" if ord(c) > 127 else " ") for c in s).split())


def say(msg):
    print(clean(msg))


def die(msg, code=1):
    sys.stderr.write("sabha-intake: %s\n" % clean(msg))
    sys.exit(code)


def usage(code):
    (sys.stdout if code == 0 else sys.stderr).write(__doc__)
    sys.exit(code)


def parse_args(argv):
    opts, files, i = {}, [], 0
    while i < len(argv):
        a = argv[i]
        if a in ("-h", "--help"):
            usage(0)
        if a == "--apply":
            opts["apply"] = True
            i += 1
            continue
        if a in OPTS:
            if i + 1 >= len(argv) or argv[i + 1] == "" or argv[i + 1].startswith("--"):
                die("%s needs a value" % a, 2)
            opts[a[2:]] = argv[i + 1]
            i += 2
            continue
        if a.startswith("--"):
            die("unknown option %s" % a, 2)
        files.append(a)
        i += 1
    return opts, files


def load_conf():
    p = os.path.join(HERE, "sabha-for-me")
    loader = importlib.machinery.SourceFileLoader("sabha_for_me", p)
    spec = importlib.util.spec_from_loader("sabha_for_me", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod.load_conf()


def resolve(value, impl):
    p = os.path.expanduser(os.path.expandvars(value))
    return p if os.path.isabs(p) else os.path.join(impl, p)


def read_note(path):
    """The note as text, or None with the reason printed: a missing, huge, unreadable or binary file is never parsed."""
    try:
        if not os.path.isfile(path):
            say("could not read %s: not a file" % path)
            return None
        if os.path.getsize(path) > MAX_READ:
            say("could not read %s: larger than %d bytes" % (path, MAX_READ))
            return None
        with open(path, "rb") as f:
            raw = f.read()
    except OSError as e:
        say("could not read %s (%s)" % (path, e.strerror))
        return None
    if b"\x00" in raw:
        say("could not read %s: binary data (an image needs a transcript .txt next to it)" % path)
        return None
    return raw.decode("ascii", errors="replace")


def parse(text):
    """({facts, decisions, asks} lists of cleaned entries, number of skipped lines)."""
    out = {"facts": [], "decisions": [], "asks": []}
    section, skipped = None, 0
    for line in text.split("\n"):
        s = clean(line)
        if not s:
            continue
        s = re.sub(r"^#+\s*", "", s)
        s = re.sub(r"^(?:[-*+]|\d{1,3}[.)])\s+", "", s)
        s = re.sub(r"^\[[ xX]?\]\s*", "", s)
        m = re.match(r"^%s\s*:\s*(.*)$" % KIND_RE, s, re.I)
        if m:
            kind, rest = KINDS[m.group(1).lower()], m.group(2).strip()
            if not rest:
                section = kind
                continue
            entry = rest
        elif re.match(r"^%s\s*$" % KIND_RE, s, re.I):
            section = KINDS[s.lower()]
            continue
        elif section:
            kind, entry = section, s
        else:
            skipped += 1
            continue
        entry = entry[:TEXT_MAX]
        if entry and entry not in out[kind]:
            out[kind].append(entry)
    return out, skipped


class Lock:
    """mkdir lock: a lock older than LOCK_STALE seconds belongs to a dead run and is taken over."""

    def __init__(self, path):
        self.path = path + ".lock"

    def __enter__(self):
        end = time.time() + 15
        while True:
            try:
                os.mkdir(self.path)
                return self
            except FileExistsError:
                try:
                    if time.time() - os.stat(self.path).st_mtime > LOCK_STALE:
                        os.rmdir(self.path)
                        continue
                except OSError:
                    pass
                if time.time() > end:
                    die("another intake holds %s; remove it if none runs" % self.path)
                time.sleep(0.1)

    def __exit__(self, *exc):
        try:
            os.rmdir(self.path)
        except OSError:
            pass


def write_atomic(path, text):
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".intake-")
    try:
        with os.fdopen(fd, "w", encoding="ascii") as f:
            f.write(text)
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def append(path, line):
    fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
    try:
        os.write(fd, (line + "\n").encode("ascii"))
    finally:
        os.close(fd)


def ledger_keys(path):
    keys = set()
    try:
        with open(path, encoding="ascii", errors="replace") as f:
            for line in f:
                p = [x.strip() for x in line.split("|")]
                if len(p) >= 2:
                    keys.add((p[0], p[1]))
    except OSError:
        pass
    return keys


def run_tool(name, args, impl, stdin_text):
    r = subprocess.run([os.path.join(HERE, name)] + args, input=stdin_text, capture_output=True, text=True,
                       env=dict(os.environ, SABHA_IMPL=impl))
    if r.returncode != 0:
        say("%s failed (exit %d): %s" % (name, r.returncode, (r.stderr or r.stdout).strip()[:200]))
        return None
    return r.stdout.strip()


def digest_text(name, h, got, skipped):
    lines = ["# Intake: %s (%s)" % (name, h[:8]), ""]
    for title, kind in (("Facts", "facts"), ("Decisions", "decisions"), ("Asks", "asks")):
        lines.append("## %s" % title)
        lines += ["- %s" % e for e in got[kind]] or ["- none"]
        lines.append("")
    lines.append("Skipped lines: %d" % skipped)
    return "\n".join(lines) + "\n"


def file_one(path, opts, impl, dirs, apply_):
    text = read_note(path)
    if text is None:
        return False
    got, skipped = parse(text)
    n = {k: len(v) for k, v in got.items()}
    h = hashlib.sha256(clean(text).encode("ascii")).hexdigest()
    name = re.sub(r"[^A-Za-z0-9._-]", "_", os.path.splitext(os.path.basename(path))[0])[:60] or "note"
    say("%s: %d facts, %d decisions, %d asks, %d lines skipped" % (path, n["facts"], n["decisions"], n["asks"], skipped))
    if not any(n.values()):
        say("nothing found in %s: no Facts, Decisions or Asks section and no Fact:/Decision:/Ask: line" % path)
        return False
    if sum(n.values()) > MAX_ENTRIES:
        say("%s holds more than %d entries; split the note" % (path, MAX_ENTRIES))
        return False
    for k, e in enumerate(got["asks"], 1):
        say("  ask %d: %s" % (k, e))
    if not apply_:
        say("  dry run: nothing written (add --apply to file %d ask(s) to %s)" % (n["asks"], opts["to"]))
        return True
    for d in (dirs["root"], dirs["digests"]):
        if os.path.islink(d):
            die("%s is a symlink; refusing to write through it" % d)
        os.makedirs(d, exist_ok=True)
    digest = os.path.join(dirs["digests"], "%s-%s.md" % (name, h[:8]))
    ledger = os.path.join(dirs["root"], "ledger")
    ok = True
    with Lock(ledger):
        if os.path.islink(digest) or os.path.islink(ledger):
            die("a digest or ledger path is a symlink; refusing to write through it")
        if not os.path.exists(digest):
            write_atomic(digest, digest_text(name, h, got, skipped))
        say("  digest: %s" % digest)
        done = ledger_keys(ledger)
        for k, e in enumerate(got["asks"], 1):
            key = "%s:%d" % (h[:16], k)
            utc = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
            brief = None
            if (key, "brief") in done:
                say("  ask %d: brief already filed" % k)
            else:
                body = "Source: %s (intake digest %s)\nAsk %d of %d: %s\n" % (name, digest, k, n["asks"], e)
                brief = run_tool("sabha-brief", [opts["to"], opts["from"], "intake-%s-%d" % (h[:8], k), e[:100]],
                                 impl, body)
                if brief is None:
                    ok = False
                    continue
                append(ledger, "%s | brief | %s | %s" % (key, utc, clean(brief)))
                say("  ask %d: brief %s" % (k, brief))
            if (key, "item") in done:
                say("  ask %d: board row already filed" % k)
                continue
            why = "why: from %s, ask %d of %d%s\n" % (name, k, n["asks"], "; brief " + brief if brief else "")
            item = run_tool("sabha-item", ["add", opts["from"], e[:120]], impl, why)
            if item is None:
                ok = False
                continue
            append(ledger, "%s | item | %s | %s" % (key, utc, clean(item)))
            say("  ask %d: board row %s" % (k, item))
    return ok


def main(argv):
    opts, files = parse_args(argv)
    conf = load_conf()
    impl = conf["SABHA_IMPL"]
    opts.setdefault("to", conf.get("SABHA_INTAKE_TO", "Dispatcher"))
    opts.setdefault("from", conf.get("SABHA_INTAKE_FROM", "intake"))
    for k in ("to", "from"):
        if not NAME_RE.match(opts[k]):
            die("bad --%s name %r (letters, digits, - _)" % (k, clean(opts[k])), 2)
    root = resolve(opts["dir"] if "dir" in opts else conf.get("SABHA_INTAKE_DIR", "intake"), impl)
    dirs = {"root": root, "drop": os.path.join(root, "drop"), "digests": os.path.join(root, "digests")}
    if not files:
        try:
            names = sorted(os.listdir(dirs["drop"]))
        except OSError:
            die("no files given and no drop folder %s" % dirs["drop"])
        files = [os.path.join(dirs["drop"], n) for n in names if n.lower().endswith((".txt", ".md"))]
        for n in names:
            if n.lower().endswith((".png", ".jpg", ".jpeg", ".gif", ".webp")):
                stem = os.path.join(dirs["drop"], os.path.splitext(n)[0])
                if not (os.path.exists(stem + ".txt") or os.path.exists(stem + ".md")):
                    say("%s: waiting for a transcript (%s.txt)" % (os.path.join(dirs["drop"], n), stem))
        if not files:
            say("no notes in %s" % dirs["drop"])
            return 0
    bad = 0
    for f in files:
        if not file_one(f, opts, impl, dirs, bool(opts.get("apply"))):
            bad += 1
    return 1 if bad else 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except OSError as e:
        die("write failed (%s); check <dir>/ledger before a rerun" % e.strerror)
