#!/usr/bin/env bash
# Read-only: for each roster role, every claude process started with that session name (pid, tty, start time),
# marked DUPLICATE when more than one holds the name. The relay is listed too. Once a role is on a named account
# (SABHA_ACCOUNT_<Role>) it also prints "<Role> -> account NAME (token variable present|MISSING)" per role, "default
# login" for the others; no value is shown. Exits 1 when a role is duplicated or a named account has no token
# variable, 2 when the process list cannot be read, else 0.
#   sabha-check
#   sabha-check --explain   also asks herdr why each recorded pane shows its state (`herdr agent explain`, read-only;
#                           it never starts a herdr server)
# Roster from sabha.conf as sabha-up.sh reads it; SABHA_PS_FILE replaces the live process list (see sabha-lib.sh).
set -uo pipefail

# shellcheck source=sabha-lib.sh
. "$(cd "$(dirname "$0")" && pwd)/sabha-lib.sh"
explain=0
[[ ${1:-} == --explain ]] && explain=1
sabha_load sabha-check

procs=$(sabha_procs) || { echo "sabha-check: cannot read the process list" >&2; exit 2; }
dup=0
printf '%-13s  %6s  %-8s  %-20s  %s\n' role pid tty start note
for name in "${NAMES[@]}"; do
  rows=$(awk -v n="$name" '$1 == n' <<<"$procs")
  if [[ -z $rows ]]; then printf '%-13s  %6s  %-8s  %-20s  %s\n' "$name" - - - "not running"; continue; fi
  note=""
  (( $(wc -l <<<"$rows") > 1 )) && { note=DUPLICATE; dup=1; }
  while read -r _ pid tty day time; do
    printf '%-13s  %6s  %-8s  %-20s  %s\n' "$name" "$pid" "$tty" "$day $time" "$note"
  done <<<"$rows"
done
echo "(ps sees only claude -n/--name sessions; cross-check ListAgents)"
# accounts: one line per role once any account is configured; names only, a token value is never read into the output
acct_rows="" acct_bad=0 acct_any=0
for name in "${NAMES[@]}"; do
  sabha_role "$name" 2>/dev/null && [[ $R_AGENT != claude ]] && { acct_rows+="$name -> not a claude role ($R_AGENT)"$'\n'; continue; }
  a=$(sabha_account "$name" 2>&1) || { acct_rows+="$name -> WARN $a"$'\n'; acct_bad=1 acct_any=1; continue; }
  if [[ -z $a ]]; then acct_rows+="$name -> default login"$'\n'; continue; fi
  acct_any=1
  if sabha_account_has_token "$a"; then t=present; else t=MISSING; acct_bad=1; fi
  acct_rows+="$name -> account $a (token variable $t)"$'\n'
done
if [[ -n ${SABHA_ACCOUNTS:-} ]] || (( acct_any )); then
  printf '%s' "$acct_rows"
  (( acct_bad )) && echo "WARN: a role names an account whose CLAUDE_CODE_OAUTH_TOKEN_ACCOUNT_<NAME> is not set (environment or $(sabha_env_file)); sabha-up and sabha-loop refuse to start it"
  (( acct_bad )) && dup=1
fi
if (( explain )); then
  # shellcheck source=sabha-herdr.sh
  . "$(cd "$(dirname "$0")" && pwd)/sabha-herdr.sh"
  pf=$SABHA_IMPL/status/herdr-panes.txt
  if [[ ! -f $pf ]]; then echo "--- no status/herdr-panes.txt: no herdr panes recorded"
  elif sabha_herdr_guard; then
    while read -r n p _; do
      [[ -n $n ]] || continue
      echo "--- $n ($p): herdr agent explain"
      # </dev/null: herdr would otherwise read the rest of the panes file as its stdin
      sabha_h agent explain "$p" </dev/null 2>&1 | head -20
    done <"$pf"
  fi
fi
exit "$dup"
