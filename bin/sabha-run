#!/usr/bin/env bash
# Headless runner: for each served role with a brief nobody has acked, starts ONE `claude -p` for that role, which
# does the brief, writes NNN.done and the status file, and exits. Memory is held only while a brief runs.
#   sabha-run [Name...]          one pass: start what is due, in the background, and exit (no Name: the served roles)
#   sabha-run --wait [Name...]   the same, then wait for the runs it started (tests, cron)
#   sabha-run --print [Name...]  dry run: print the exact command per due brief; writes nothing, starts nothing
# A pass is cheap, so call it right after writing a brief, or let sabha-watch call it (SABHA_RUN_AUTO=1).
# Served roles: SABHA_RUN_ROLES (lazy | all | Name list; default lazy). The relay is never run headless; an ondemand
# role only when named. Design and limits: docs/headless-runner.md. Windows: not covered yet.
set -uo pipefail

SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
# shellcheck source-path=SCRIPTDIR source=sabha-lib.sh
. "$(dirname "$SELF")/sabha-lib.sh"
sabha_load sabha-run
PROJECT=${SABHA_PROJECT:-this project}
MAX=${SABHA_RUN_MAX:-2}
TIMEOUT=${SABHA_RUN_TIMEOUT:-3600}
LOGS=${SABHA_RUN_LOGS:-$SABHA_IMPL/runs}
utc() { date -u +%Y-%m-%dT%H:%M:%SZ; }
sq() { local q="'\\''"; case $1 in *[!A-Za-z0-9_./:=-]*) printf "'%s'" "${1//\'/$q}" ;; *) printf %s "$1" ;; esac; }

# role_cmd <Name> <brief file>: sets CMD (the claude argv) for that role and brief
role_cmd() {
  local r name model effort lower to n who
  sabha_role "$1" || { echo "sabha-run: unknown role $1" >&2; return 1; }
  r=$R_ENTRY name=$R_NAME model=$R_MODEL effort=$R_EFFORT
  who=$name; [[ -n $R_LABEL ]] && who="$name ($R_LABEL)"
  lower=$(tr '[:upper:]' '[:lower:]' <<<"$name")
  n=$(basename "$2"); n=${n:0:3}
  to=$DISPATCHER; [[ $R_BASE == "$DISPATCHER" ]] && to=$RELAY
  CMD=(claude -p -n "$name" --model "$model" --effort "$effort")
  # MCP servers each cost memory; "mcp" in the roster flags keeps them, as in sabha-up.sh
  sabha_flag "$r" mcp || CMD+=(--strict-mcp-config)
  # nobody is at a terminal: a prompt must turn into a denial, not a hang until the timeout
  CMD+=(--permission-prompts none)
  CMD+=("You are $who in $PROJECT session setup, running headless (claude -p): nobody answers you or a permission prompt. Read $(sabha_reads "$name"), then the brief $2 (sabha-run already wrote its $n.ack). Do the brief, update status/$lower.md, write inbox/$name/$n.done (result for $to), then stop. A denied action ends the work: append the denial to $SABHA_IMPL/for-me.items, write $n.done with result: BLOCKED <the denial>, and stop; never work around a denial. Start no other brief.")
}

# served: true when this pass may run <Name> (named = on the command line)
served() {
  local r named=$2
  [[ $1 == "$RELAY" ]] && return 1
  sabha_role "$1" || return 1
  r=$R_ENTRY
  # only claude runs headless here; the other agents (opencode, codex, agy, muse) go through the herdr backend
  [[ $R_AGENT == claude ]] || return 1
  (( named )) && return 0
  sabha_flag "$r" ondemand && return 1
  case ${SABHA_RUN_ROLES:-lazy} in
    lazy) sabha_flag "$r" lazy ;;
    all) return 0 ;;
    *) [[ " $SABHA_RUN_ROLES " == *" $1 "* ]] ;;
  esac
}

# due <Name>: prints the lowest brief with no .ack, .cancel or .done
due() {
  local b n d=$SABHA_IMPL/inbox/$1
  for b in "$d"/[0-9][0-9][0-9]-*.md; do
    [[ -e $b ]] || continue
    n=$(basename "$b"); n=${n:0:3}
    [[ -e $d/$n.ack || -e $d/$n.cancel || -e $d/$n.done ]] && continue
    echo "$b"; return 0
  done
  return 1
}

# live_lock <file>: true when the lock names a live pid; a dead one is removed
# ponytail: two passes can both clear the same stale lock; the noclobber take after it still lets only one win
live_lock() {
  local pid
  [[ -e $1 ]] || return 1
  pid=$(cat "$1" 2>/dev/null)
  [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null && return 0
  rm -f "$1"; return 1
}

# --child <Name> <brief> <log>: the run itself (spawned by a pass, holds inbox/<Name>/run.lock)
if [[ ${1:-} == --child ]]; then
  name=$2 brief=$3 log=$4
  dir=$SABHA_IMPL/inbox/$name; n=$(basename "$brief"); n=${n:0:3}
  # the child writes its own pid before anything else, so its EXIT trap can never run before the lock names it;
  # the pass waits for this line as its proof that the run started
  echo $$ >|"$dir/run.lock"
  trap 'rm -f "$dir/run.lock"' EXIT
  role_cmd "$name" "$brief"
  { echo "sabha-run: $(utc) start $name $n, timeout ${TIMEOUT}s"; echo "sabha-run: cd $SABHA_WS && ${CMD[*]}"; } >>"$log"
  timed=0
  if cd "$SABHA_WS"; then
    # set -m gives claude its own process group, so the timeout also stops the builds and servers its tools started
    set -m
    "${CMD[@]}" </dev/null >>"$log" 2>&1 &
    cp=$!
    set +m
    # a 1 s watch, not `timeout`: stock macOS has none
    end=$(( SECONDS + TIMEOUT ))
    while kill -0 "$cp" 2>/dev/null; do
      if (( SECONDS >= end )); then
        timed=1; kill -TERM -- -"$cp" 2>/dev/null
        for _ in 1 2 3 4 5; do kill -0 -- -"$cp" 2>/dev/null || break; sleep 1; done
        kill -KILL -- -"$cp" 2>/dev/null
        break
      fi
      sleep 1
    done
    wait "$cp"; rc=$?
    why="exit $rc"; (( timed )) && why="timeout after ${TIMEOUT}s"
  else
    why="cannot cd to $SABHA_WS"
  fi
  echo "sabha-run: $(utc) end $name $n: $why" >>"$log"
  sabha_role "$name" && sabha_cost_log "$name" "$R_MODEL" "brief $n $why"
  # the sender waits on a .done; a run that died without one still has to say so
  if [[ ! -e $dir/$n.done ]]; then
    printf 'utc: %s\nsession: %s [headless]\nresult: BLOCKED headless run ended without a done (%s), log %s\ncontext: 0\n' \
      "$(utc)" "$name" "$why" "$log" >"$dir/$n.done"
  fi
  exit 0
fi

PRINT=0 WAIT=0
while [[ ${1:-} == --* ]]; do
  case $1 in
    --print) PRINT=1 ;;
    --wait) WAIT=1 ;;
    *) echo "usage: sabha-run [--print | --wait] [Name...]" >&2; exit 2 ;;
  esac
  shift
done
named=0 want=("${NAMES[@]}")
if (( $# )); then
  named=1 want=("$@")
  for w in "${want[@]}"; do [[ " ${NAMES[*]} " == *" $w "* ]] || { echo "sabha-run: unknown role: $w" >&2; exit 2; }; done
fi

# a role already running interactively (a pane, a hand start) owns its inbox
procs=$(sabha_procs) || { echo "sabha-run: cannot read the process list; nothing started" >&2; exit 2; }
running=0
for l in "$SABHA_IMPL"/inbox/*/run.lock; do live_lock "$l" && running=$(( running + 1 )); done

started=0
for name in "${want[@]}"; do
  served "$name" "$named" || { (( named )) && echo "sabha-run: $name: the relay is never run headless"; continue; }
  brief=$(due "$name") || continue
  dir=$SABHA_IMPL/inbox/$name; n=$(basename "$brief"); n=${n:0:3}
  if awk -v n="$name" '$1 == n { f = 1 } END { exit !f }' <<<"$procs"; then
    echo "sabha-run: $name $n: a live claude -n $name holds the role; left to it"; continue
  fi
  if live_lock "$dir/run.lock"; then echo "sabha-run: $name $n: a run is already on $name (run.lock)"; continue; fi
  if (( running >= MAX )); then echo "sabha-run: $name $n: cap of $MAX runs reached; next pass"; continue; fi
  log=$LOGS/$name-$n-$(date -u +%Y%m%dT%H%M%SZ).log
  if (( PRINT )); then
    role_cmd "$name" "$brief"
    # single quotes, not %q: the line stays readable and still pastes into bash or zsh
    line="cd $(sq "$SABHA_WS") &&"
    for a in "${CMD[@]}"; do line+=" $(sq "$a")"; done
    echo "$line"
    running=$(( running + 1 )); continue
  fi
  # per-role single flight: noclobber, like the brief-number claim (docs/inbox-protocol.md section 2)
  (set -C; echo $$ >"$dir/run.lock") 2>/dev/null || { echo "sabha-run: $name $n: run.lock taken"; continue; }
  # the ack is the brief's claim: a pane or another pass that acked first wins
  if ! (set -C; printf 'utc: %s\nsession: %s [headless]\nlog: %s\ncontext: 0\n' "$(utc)" "$name" "$log" >"$dir/$n.ack") 2>/dev/null; then
    rm -f "$dir/run.lock"; echo "sabha-run: $name $n: already acked"; continue
  fi
  mkdir -p "$LOGS"
  # SABHA_RUN_SELF replaces the child program (tests: a missing one is a spawn that fails)
  nohup "${SABHA_RUN_SELF:-$SELF}" --child "$name" "$brief" "$log" </dev/null >/dev/null 2>&1 &
  cpid=$!
  # started = the child wrote its pid to the lock, or already finished (lock gone, done written); up to 5 s
  ok=0
  for _ in $(seq 1 50); do
    [[ $(cat "$dir/run.lock" 2>/dev/null) == "$cpid" || -e $dir/$n.done ]] && { ok=1; break; }
    kill -0 "$cpid" 2>/dev/null || break
    sleep 0.1
  done
  [[ $(cat "$dir/run.lock" 2>/dev/null) == "$cpid" || -e $dir/$n.done ]] && ok=1
  if (( ! ok )); then
    # never leave an ack with no done and a lock nobody holds: the sender would wait forever
    kill "$cpid" 2>/dev/null
    printf 'utc: %s\nsession: %s [headless]\nresult: BLOCKED headless run did not start (child %s), log %s\ncontext: 0\n' \
      "$(utc)" "$name" "${SABHA_RUN_SELF:-$SELF}" "$log" >"$dir/$n.done"
    rm -f "$dir/run.lock"
    echo "sabha-run: $name $n: run did not start; BLOCKED done written"; continue
  fi
  echo "sabha-run: started $name $n (pid $cpid), log $log"
  running=$(( running + 1 )) started=$(( started + 1 ))
done
(( WAIT && started )) && wait
exit 0
