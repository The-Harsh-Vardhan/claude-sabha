#!/usr/bin/env bash
# sabha-rotate: keep the top block and the newest N (10) entries of each status/<role>.md, move the older entries to
# status/.bak/<role>-<utc>.md. Never deletes. Dry run is the default; --apply writes.
# An entry starts at a line "UPDATE <n>", "Current:", "Idle:" or "# HANDOFF" (the shapes the live files use; newest
# first). Anything before the first entry stays with the top block. Files with no entry are left alone.
# Restore: the archive's RESTORE line (also in .bak/RESTORE.txt) appends the moved entries back in their old order.
# Usage: sabha-rotate [--dry-run|--apply] [--keep N] [<status-dir> | <file.md>...]   (default dir: $SABHA_IMPL/status)
set -u
mode=dry keep=10 args=()
while [[ $# -gt 0 ]]; do
  case $1 in
    --dry-run) mode=dry ;;
    --apply) mode=apply ;;
    --keep) keep=${2:-}; shift ;;
    -h|--help) sed -n '2,7p' "$0"; exit 0 ;;
    -*) echo "sabha-rotate: unknown flag $1" >&2; exit 2 ;;
    *) args+=("$1") ;;
  esac
  shift
done
[[ $keep =~ ^[0-9]+$ ]] || { echo "sabha-rotate: --keep needs a number" >&2; exit 2; }
if [[ ${#args[@]} -eq 0 ]]; then
  [[ -n ${SABHA_IMPL:-} ]] || { echo "sabha-rotate: name a status dir or set SABHA_IMPL" >&2; exit 2; }
  args=("$SABHA_IMPL/status")
fi
files=()
for a in "${args[@]}"; do
  if [[ -d $a ]]; then for f in "$a"/*.md; do [[ -f $f ]] && files+=("$f"); done
  elif [[ -f $a ]]; then files+=("$a")
  else echo "sabha-rotate: no such file or dir: $a" >&2; exit 2; fi
done
[[ ${#files[@]} -gt 0 ]] || { echo "sabha-rotate: no status files"; exit 0; }

# line number where entry keep+2 starts (top block + keep entries stay above it); empty = nothing to move
cut_line() {
  awk -v want=$((keep + 2)) '/^(UPDATE [0-9]+|Current:|Idle:|# HANDOFF)/ { if (++n == want) { print NR; exit } }' "$1"
}

utc=$(date -u +%Y%m%dT%H%M%SZ)
tot_before=0 tot_after=0 moved=0 rc=0
for f in "${files[@]}"; do
  n=$(cut_line "$f")
  [[ -n $n ]] || continue
  before=$(wc -c <"$f" | tr -d ' ')
  kept=$(head -n $((n - 1)) "$f" | wc -c | tr -d ' ')
  entries=$(tail -n +"$n" "$f" | grep -cE '^(UPDATE [0-9]+|Current:|Idle:|# HANDOFF)')
  echo "$f: $before -> $kept bytes, move $entries entries ($((before - kept)) bytes)"
  tot_before=$((tot_before + before)) tot_after=$((tot_after + kept)) moved=$((moved + 1))
  [[ $mode == apply ]] || continue
  dir=$(dirname "$f") role=$(basename "$f" .md)
  bak=$dir/.bak arc=$dir/.bak/$role-$utc.md
  mkdir -p "$bak" || { rc=1; continue; }
  sum=$(cksum <"$f")
  restore="sed '1,/^--- archived ---\$/d' '$arc' >> '$f'"
  { echo "RESTORE: $restore"; echo "--- archived ---"; tail -n +"$n" "$f"; } >"$arc.tmp" &&
    head -n $((n - 1)) "$f" >"$f.rotate.tmp" || { rm -f "$arc.tmp" "$f.rotate.tmp"; rc=1; continue; }
  # a live role may have written meanwhile: then leave this file for the next run
  if [[ $(cksum <"$f") != "$sum" ]]; then
    echo "$f: changed while rotating, skipped" >&2; rm -f "$arc.tmp" "$f.rotate.tmp"; rc=1; continue
  fi
  if [[ -e $arc ]]; then echo "$arc exists, skipped" >&2; rm -f "$arc.tmp" "$f.rotate.tmp"; rc=1; continue; fi
  mv "$arc.tmp" "$arc" && mv "$f.rotate.tmp" "$f" && echo "$restore" >>"$bak/RESTORE.txt" || rc=1
done
echo "sabha-rotate ($mode): $moved file(s), $tot_before -> $tot_after bytes"
[[ $mode == dry && $moved -gt 0 ]] && echo "sabha-rotate: dry run, nothing written; --apply to rotate"
exit $rc
