#!/usr/bin/env python3
"""sabha prs: the PR radar. One table of an author's open PRs across orgs and repos, worst first. Read-only: every
GitHub read goes through bin/sabha-gh (cached, quota-checked, no write possible); it never closes or comments.

  sabha-prs [--org ORG ...] [--author LOGIN] [--repo OWNER/NAME ...] [--md FILE] [--json] [--fresh]

Defaults: SABHA_PRS_ORGS (space separated), SABHA_PRS_AUTHOR, SABHA_PRS_REPOS (space separated), from the environment
or sabha.conf. --org searches the org for the author; --repo searches that one repo (an own repo outside the org).
Flag, worst first: ARCHIVED (the repo is read-only), CONFLICT (cannot merge as is), BEHIND>50 (more than 50 commits
behind its base), CHANGES_REQUESTED, STALE>7d (no update for a week), else ok. Columns: repo, #, title, base, age
(days since opened), review, mergeable, behind, flag. gh needs a plain terminal; data from the cache is marked STALE.
Search lists the first 100 PRs per target. SABHA_NOW (epoch seconds) pins the clock for tests.
"""
import argparse
import datetime
import json
import os
import re
import subprocess
import sys
import time

BIN = os.path.dirname(os.path.abspath(__file__))
GH = os.path.join(BIN, "sabha-gh")
RANK = ["ARCHIVED", "CONFLICT", "BEHIND>50", "CHANGES_REQUESTED", "STALE>7d", "ok"]
stale_reasons = []


class GhError(Exception):
    def __init__(self, msg, rc):
        Exception.__init__(self, msg)
        self.rc = rc


def gh(fresh, *args):
    cmd = [GH] + (["--fresh"] if fresh else []) + list(args)
    p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, universal_newlines=True)
    if p.returncode == 10:
        stale_reasons.append(p.stderr.strip().splitlines()[0] if p.stderr.strip() else "cached copy")
    elif p.returncode != 0:
        raise GhError(p.stderr.strip().splitlines()[-1] if p.stderr.strip() else "sabha-gh failed", p.returncode)
    return json.loads(p.stdout)


def conf_value(key):
    if os.environ.get(key) is not None:
        return os.environ[key]
    path = os.environ.get("SABHA_CONF") or os.path.join(BIN, "..", "sabha.conf")
    try:
        for line in open(path, encoding="ascii", errors="replace"):
            m = re.match(r"^%s=(.*)$" % key, line.strip())
            if m:
                return m.group(1).strip().strip("\"'")
    except OSError:
        pass
    return ""


def parse_ts(s):
    return datetime.datetime.strptime(s, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=datetime.timezone.utc).timestamp()


def row_for(item, fresh, now, repos, warns):
    repo, num = item["repo"], item["number"]
    row = dict(repo=repo, number=num, title=item["title"], base="?", age=int((now - parse_ts(item["created_at"])) // 86400),
               review="-", mergeable="?", merge_state="?", behind=None, archived=False, draft=bool(item.get("draft")),
               updated_days=int((now - parse_ts(item["updated_at"])) // 86400), url=item.get("url", ""))
    try:
        pr = gh(fresh, "pr", repo, str(num))
        row.update(base=pr["baseRefName"], review=pr.get("reviewDecision") or "-", mergeable=pr.get("mergeable") or "?",
                   merge_state=pr.get("mergeStateStatus") or "?")
        head = pr["headRefName"]
        hr = (pr.get("headRepository") or {}).get("nameWithOwner")
        if hr and hr != repo:
            head = "%s:%s" % (hr.split("/")[0], head)
        row["behind"] = gh(fresh, "compare", repo, pr["baseRefName"], head)["behind_by"]
    except (GhError, KeyError, TypeError) as e:
        if isinstance(e, GhError) and e.rc in (2, 3):
            raise
        warns.append("%s#%s: PR details incomplete (%s)" % (repo, num, e))
    if repo not in repos:
        try:
            repos[repo] = bool(gh(fresh, "repo", repo)["archived"])
        except (GhError, KeyError, TypeError) as e:
            if isinstance(e, GhError) and e.rc in (2, 3):
                raise
            repos[repo] = False
            warns.append("%s: could not read the repo, ARCHIVED unchecked (%s)" % (repo, e))
    row["archived"] = repos[repo]
    if row["archived"]:
        flag = "ARCHIVED"
    elif row["merge_state"] == "DIRTY" or row["mergeable"] == "CONFLICTING":
        flag = "CONFLICT"
    elif row["behind"] is not None and row["behind"] > 50:
        flag = "BEHIND>50"
    elif row["review"] == "CHANGES_REQUESTED":
        flag = "CHANGES_REQUESTED"
    elif row["updated_days"] > 7:
        flag = "STALE>7d"
    else:
        flag = "ok"
    row["flag"] = flag
    return row


def cells(r):
    t = r["title"] if len(r["title"]) <= 60 else r["title"][:57] + "..."
    return [r["repo"], str(r["number"]), t, r["base"], "%dd" % r["age"], r["review"], r["mergeable"],
            "?" if r["behind"] is None else str(r["behind"]), r["flag"]]


HEAD = ["repo", "#", "title", "base", "age", "review", "mergeable", "behind", "flag"]


def main():
    ap = argparse.ArgumentParser(prog="sabha-prs", description="PR radar (read-only)")
    ap.add_argument("--org", action="append", default=[])
    ap.add_argument("--repo", action="append", default=[])
    ap.add_argument("--author", default="")
    ap.add_argument("--md")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--fresh", action="store_true")
    a = ap.parse_args()
    orgs = a.org or conf_value("SABHA_PRS_ORGS").split()
    repos_in = a.repo or conf_value("SABHA_PRS_REPOS").split()
    author = a.author or conf_value("SABHA_PRS_AUTHOR")
    if not author or not (orgs or repos_in):
        sys.exit("sabha prs: need --author (or SABHA_PRS_AUTHOR) and at least one --org or --repo (SABHA_PRS_ORGS, SABHA_PRS_REPOS)")
    now = float(os.environ.get("SABHA_NOW") or time.time())
    items, seen, warns, repo_state = [], set(), [], {}
    try:
        for target in orgs + repos_in:
            res = gh(a.fresh, "prs-by-author", target, author)
            if res["total"] > len(res["items"]):
                warns.append("%s: %d open PRs, only the first %d listed" % (target, res["total"], len(res["items"])))
            for it in res["items"]:
                if (it["repo"], it["number"]) not in seen:
                    seen.add((it["repo"], it["number"]))
                    items.append(it)
        rows = [row_for(it, a.fresh, now, repo_state, warns) for it in items]
    except GhError as e:
        sys.exit("sabha prs: %s" % e)
    rows.sort(key=lambda r: (RANK.index(r["flag"]), -r["age"], r["repo"], r["number"]))
    if a.json:
        print(json.dumps(dict(stale=bool(stale_reasons), rows=rows), indent=1))
    else:
        lines = []
        if stale_reasons:
            lines.append("STALE: part of this table is from the cache (%s)" % stale_reasons[0])
        table = [HEAD] + [cells(r) for r in rows]
        w = [max(len(c[i]) for c in table) for i in range(len(HEAD))]
        if rows:
            lines += ["  ".join(c[i].ljust(w[i]) for i in range(len(HEAD))).rstrip() for c in table]
        else:
            lines.append("no open PRs")
        lines += ["note: " + x for x in warns]
        print("\n".join(lines))
    if a.md:
        md = []
        if stale_reasons:
            md.append("STALE: part of this table is from the cache (%s)\n" % stale_reasons[0])
        if rows:
            md.append("| " + " | ".join(HEAD) + " |")
            md.append("| " + " | ".join("---" for _ in HEAD) + " |")
            md += ["| " + " | ".join(c.replace("|", "/") for c in cells(r)) + " |" for r in rows]
        else:
            md.append("no open PRs")
        md += ["", "note: " + " / ".join(warns)] if warns else []
        open(a.md, "w", encoding="ascii", errors="replace").write("\n".join(md) + "\n")


if __name__ == "__main__":
    main()
