#!/bin/sh
# The only "gh" a test may reach; it never touches the network. Logs every call to $FAKE_GH_DIR/calls. Answers:
#   api user          -> $FAKE_GH_LOGIN (default fake-user)
#   api rate_limit    -> $FAKE_GH_LEFT (default 5000)
#   anything else     -> the file named by the first line of $FAKE_GH_DIR/map ("substring|file") whose substring is in
#                        the argv; no line matches -> "HTTP 404", exit 1
# FAKE_GH_FAIL=1 makes every call fail with $FAKE_GH_ERR. The fixtures hold what --jq would have printed.
: "${FAKE_GH_DIR:=${TMPDIR:-/tmp}/sabha-fake-gh}"
mkdir -p "$FAKE_GH_DIR"
echo "$*" >> "$FAKE_GH_DIR/calls"
if [ -n "$FAKE_GH_FAIL" ]; then echo "${FAKE_GH_ERR:-error connecting to api.github.com}" >&2; exit 1; fi
case $* in
  "api user "*) echo "${FAKE_GH_LOGIN:-fake-user}"; exit 0 ;;
  "api rate_limit "*) echo "${FAKE_GH_LEFT:-5000}"; exit 0 ;;
esac
[ -f "$FAKE_GH_DIR/map" ] && while IFS='|' read -r pat file; do
  case $* in *"$pat"*) cat "$file"; exit 0 ;; esac
done < "$FAKE_GH_DIR/map"
echo "gh: Not Found (HTTP 404)" >&2
exit 1
