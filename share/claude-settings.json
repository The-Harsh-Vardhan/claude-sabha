{
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(git -C * push:*)",
      "Bash(gh pr:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -r -f:*)",
      "Bash(rm -f -r:*)",
      "Bash(cat *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(less *.env*)",
      "Bash(grep * *.env*)",
      "Bash(source *.env*)",
      "Bash(cat *.npmrc*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.npmrc)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)"
    ]
  }
}
